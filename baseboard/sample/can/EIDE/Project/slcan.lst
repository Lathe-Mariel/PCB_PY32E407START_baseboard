 435:../Src/slcan.c ****   * @brief  Start the next UART transmission if the port is idle.
 436:../Src/slcan.c ****   */
 437:../Src/slcan.c **** static void SLCAN_TxKick(void)
 438:../Src/slcan.c **** {
 439:../Src/slcan.c ****   uint32_t primask = __get_PRIMASK();
 440:../Src/slcan.c ****   uint32_t chunk;
 441:../Src/slcan.c **** 
 442:../Src/slcan.c ****   __disable_irq();
 443:../Src/slcan.c **** 
 444:../Src/slcan.c ****   if ((SlcanTxBusy != 0U) || (SlcanTxHead == SlcanTxTail))
 445:../Src/slcan.c ****   {
 446:../Src/slcan.c ****     __set_PRIMASK(primask);
 447:../Src/slcan.c ****     return;
 448:../Src/slcan.c ****   }
