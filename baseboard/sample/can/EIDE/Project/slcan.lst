   1:../Src/slcan.c **** /**
   2:../Src/slcan.c ****   ******************************************************************************
   3:../Src/slcan.c ****   * @file    slcan.c
   4:../Src/slcan.c ****   * @brief   SLCAN (LAWICEL) protocol bridge between USART1 and FDCAN1.
   5:../Src/slcan.c ****   *
   6:../Src/slcan.c ****   *          The PC drives the on-board ATA6561 CAN transceiver through a plain
   7:../Src/slcan.c ****   *          ASCII protocol:
   8:../Src/slcan.c ****   *
   9:../Src/slcan.c ****   *            t1232AABB\r          standard data frame, ID 0x123, 2 bytes
  10:../Src/slcan.c ****   *            T123456788AABBCC\r   extended data frame
  11:../Src/slcan.c ****   *            r1234\r              standard remote frame, DLC 4
  12:../Src/slcan.c ****   *            O / C                open / close the CAN channel
  13:../Src/slcan.c ****   *            L                    open in listen only mode
  14:../Src/slcan.c ****   *            S0..S9               select bit rate (10 kbit/s .. 1 Mbit/s)
  15:../Src/slcan.c ****   *            sXXYY                select bit rate through SJA1000 BTR0/BTR1
  16:../Src/slcan.c ****   *            F                    read status flags
  17:../Src/slcan.c ****   *            V / v / N            hardware+software version / serial number
  18:../Src/slcan.c ****   *            Z0 / Z1              timestamp off / on
  19:../Src/slcan.c ****   *
  20:../Src/slcan.c ****   *          Received CAN frames are pushed to the PC as "t...", "T...",
  21:../Src/slcan.c ****   *          "r..." or "R..." lines.
  22:../Src/slcan.c ****   ******************************************************************************
  23:../Src/slcan.c ****   */
  24:../Src/slcan.c **** 
  25:../Src/slcan.c **** /* Includes ------------------------------------------------------------------*/
  26:../Src/slcan.c **** #include "slcan.h"
  27:../Src/slcan.c **** 
