 404:../Src/slcan.c **** /**
 405:../Src/slcan.c ****   * @brief  Append raw bytes to the transmit ring buffer.
 406:../Src/slcan.c ****   */
 407:../Src/slcan.c **** static void SLCAN_Queue(const char *Data, uint32_t Len)
 408:../Src/slcan.c **** {
 409:../Src/slcan.c ****   uint32_t primask = __get_PRIMASK();
 410:../Src/slcan.c ****   uint32_t i;
 411:../Src/slcan.c **** 
 412:../Src/slcan.c ****   __disable_irq();
 413:../Src/slcan.c ****   for (i = 0U; i < Len; i++)
 414:../Src/slcan.c ****   {
 415:../Src/slcan.c ****     uint32_t next = (SlcanTxHead + 1U) % SLCAN_TX_RING_SIZE;
 416:../Src/slcan.c ****     if (next == SlcanTxTail)
 417:../Src/slcan.c ****     {
 418:../Src/slcan.c ****       /* Ring full: drop the remaining bytes */
 419:../Src/slcan.c ****       break;
 420:../Src/slcan.c ****     }
 421:../Src/slcan.c ****     SlcanTxRing[SlcanTxHead] = (uint8_t)Data[i];
 422:../Src/slcan.c ****     SlcanTxHead = next;
 423:../Src/slcan.c ****   }
 424:../Src/slcan.c ****   __set_PRIMASK(primask);
 425:../Src/slcan.c **** 
 426:../Src/slcan.c ****   SLCAN_TxKick();
 427:../Src/slcan.c **** }
 428:../Src/slcan.c **** 
 429:../Src/slcan.c **** static void SLCAN_QueueChar(char Ch)
 430:../Src/slcan.c **** {
 431:../Src/slcan.c ****   SLCAN_Queue(&Ch, 1U);
 432:../Src/slcan.c **** }
 433:../Src/slcan.c **** 
