 144:../Src/slcan.c **** /**
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccQpdfWz.s 			page 4


 145:../Src/slcan.c ****   * @brief  Main loop hook: parse pending UART commands and forward CAN frames.
 146:../Src/slcan.c ****   * @param  None
 147:../Src/slcan.c ****   * @retval None
 148:../Src/slcan.c ****   */
 149:../Src/slcan.c **** void SLCAN_Poll(void)
 150:../Src/slcan.c **** {
 151:../Src/slcan.c ****   uint8_t byte;
 152:../Src/slcan.c **** 
 153:../Src/slcan.c ****   /* Command characters coming from the PC */
 154:../Src/slcan.c ****   for (;;)
 155:../Src/slcan.c ****   {
 156:../Src/slcan.c ****     uint32_t primask = __get_PRIMASK();
 157:../Src/slcan.c **** 
 158:../Src/slcan.c ****     __disable_irq();
 159:../Src/slcan.c ****     if (SlcanRxTail == SlcanRxHead)
 160:../Src/slcan.c ****     {
 161:../Src/slcan.c ****       __set_PRIMASK(primask);
 162:../Src/slcan.c ****       break;
 163:../Src/slcan.c ****     }
 164:../Src/slcan.c ****     byte = SlcanRxRing[SlcanRxTail];
 165:../Src/slcan.c ****     SlcanRxTail = (SlcanRxTail + 1U) % SLCAN_RX_RING_SIZE;
 166:../Src/slcan.c ****     __set_PRIMASK(primask);
 167:../Src/slcan.c **** 
 168:../Src/slcan.c ****     if ((byte == SLCAN_CR) || (byte == '\n'))
 169:../Src/slcan.c ****     {
 170:../Src/slcan.c ****       if (SlcanLineOverflow != 0U)
 171:../Src/slcan.c ****       {
 172:../Src/slcan.c ****         SlcanLineOverflow = 0U;
 173:../Src/slcan.c ****         SlcanLineLen = 0U;
 174:../Src/slcan.c ****         SLCAN_QueueChar((char)SLCAN_BEL);
 175:../Src/slcan.c ****       }
 176:../Src/slcan.c ****       else if (SlcanLineLen > 0U)
 177:../Src/slcan.c ****       {
 178:../Src/slcan.c ****         SLCAN_HandleLine(SlcanLine, SlcanLineLen);
 179:../Src/slcan.c ****         SlcanLineLen = 0U;
 180:../Src/slcan.c ****       }
 181:../Src/slcan.c ****       else
 182:../Src/slcan.c ****       {
 183:../Src/slcan.c ****         /* Ignore CR+LF pairs and stray terminators */
 184:../Src/slcan.c ****       }
 185:../Src/slcan.c ****     }
 186:../Src/slcan.c ****     else if (SlcanLineLen < SLCAN_LINE_SIZE)
 187:../Src/slcan.c ****     {
 188:../Src/slcan.c ****       SlcanLine[SlcanLineLen] = (char)byte;
 189:../Src/slcan.c ****       SlcanLineLen++;
 190:../Src/slcan.c ****     }
 191:../Src/slcan.c ****     else
 192:../Src/slcan.c ****     {
 193:../Src/slcan.c ****       SlcanLineOverflow = 1U;
 194:../Src/slcan.c ****     }
 195:../Src/slcan.c ****   }
 196:../Src/slcan.c **** 
 197:../Src/slcan.c ****   /* Frames received from the CAN bus */
 198:../Src/slcan.c ****   while (SlcanFrameTail != SlcanFrameHead)
 199:../Src/slcan.c ****   {
 200:../Src/slcan.c ****     SLCAN_FrameTypeDef frame;
 201:../Src/slcan.c ****     uint32_t primask = __get_PRIMASK();
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccQpdfWz.s 			page 5


 202:../Src/slcan.c **** 
 203:../Src/slcan.c ****     __disable_irq();
 204:../Src/slcan.c ****     frame = SlcanFrameQueue[SlcanFrameTail];
 205:../Src/slcan.c ****     SlcanFrameTail = (SlcanFrameTail + 1U) % SLCAN_FRAME_QUEUE_SIZE;
 206:../Src/slcan.c ****     __set_PRIMASK(primask);
 207:../Src/slcan.c **** 
 208:../Src/slcan.c ****     SLCAN_SendFrame(&frame);
 209:../Src/slcan.c ****   }
 210:../Src/slcan.c **** 
 211:../Src/slcan.c ****   SLCAN_TxKick();
 212:../Src/slcan.c **** }
