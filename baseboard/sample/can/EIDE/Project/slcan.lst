 107:../Src/slcan.c **** /**
 108:../Src/slcan.c ****   * @brief  Initialize the SLCAN bridge: USART1 for the PC link and FDCAN1.
 109:../Src/slcan.c ****   *         The CAN channel stays closed until the host sends 'O' or 'L'.
 110:../Src/slcan.c ****   * @param  None
 111:../Src/slcan.c ****   * @retval None
 112:../Src/slcan.c ****   */
 113:../Src/slcan.c **** void SLCAN_Init(void)
 114:../Src/slcan.c **** {
 115:../Src/slcan.c ****   if (SLCAN_SetBitrate(SlcanBitrate) != HAL_OK)
 116:../Src/slcan.c ****   {
 117:../Src/slcan.c ****     APP_ErrorHandler();
 118:../Src/slcan.c ****   }
 119:../Src/slcan.c **** 
 120:../Src/slcan.c ****   hSlcanUart.Instance          = SLCAN_UART;
 121:../Src/slcan.c ****   hSlcanUart.Init.BaudRate     = SLCAN_UART_BAUDRATE;
 122:../Src/slcan.c ****   hSlcanUart.Init.WordLength   = SCI_WORDLENGTH_8B;
 123:../Src/slcan.c ****   hSlcanUart.Init.StopBits     = SCI_STOPBITS_1;
 124:../Src/slcan.c ****   hSlcanUart.Init.Parity       = SCI_PARITY_NONE;
 125:../Src/slcan.c ****   hSlcanUart.Init.Mode         = SCI_MODE_TX_RX;
 126:../Src/slcan.c ****   hSlcanUart.Init.HwFlowCtl    = SCI_HWCONTROL_NONE;
 127:../Src/slcan.c ****   hSlcanUart.Init.OverSampling = SCI_OVERSAMPLING_16;
 128:../Src/slcan.c ****   hSlcanUart.AdvancedInit.AdvFeatureInit = SCI_ADVFEATURE_NO_INIT;
 129:../Src/slcan.c ****   hSlcanUart.FifoMode          = SCI_FIFOMODE_DISABLE;
 130:../Src/slcan.c **** 
 131:../Src/slcan.c ****   if (HAL_SCI_Init(&hSlcanUart) != HAL_OK)
 132:../Src/slcan.c ****   {
 133:../Src/slcan.c ****     APP_ErrorHandler();
 134:../Src/slcan.c ****   }
 135:../Src/slcan.c **** 
 136:../Src/slcan.c ****   (void)HAL_SCI_Receive_IT(&hSlcanUart, &SlcanRxByte, 1U);
 137:../Src/slcan.c **** 
 138:../Src/slcan.c ****   if (SLCAN_CanApply(0U) != HAL_OK)
 139:../Src/slcan.c ****   {
 140:../Src/slcan.c ****     APP_ErrorHandler();
 141:../Src/slcan.c ****   }
 142:../Src/slcan.c **** }
