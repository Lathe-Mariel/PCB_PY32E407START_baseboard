 560:../Src/slcan.c **** static void SLCAN_SendFrame(const SLCAN_FrameTypeDef *Frame)
 561:../Src/slcan.c **** {
 562:../Src/slcan.c ****   char out[SLCAN_LINE_SIZE];
 563:../Src/slcan.c ****   uint32_t pos = 0U;
 564:../Src/slcan.c ****   uint32_t i;
 565:../Src/slcan.c **** 
 566:../Src/slcan.c ****   if (Frame->IdType == FDCAN_EXTENDED_ID)
 567:../Src/slcan.c ****   {
 568:../Src/slcan.c ****     out[pos] = (Frame->FrameType == FDCAN_REMOTE_FRAME) ? 'R' : 'T';
 569:../Src/slcan.c ****     pos++;
 570:../Src/slcan.c ****     SLCAN_Hex(&out[pos], Frame->Id, 8U);
 571:../Src/slcan.c ****     pos += 8U;
 572:../Src/slcan.c ****   }
 573:../Src/slcan.c ****   else
 574:../Src/slcan.c ****   {
 575:../Src/slcan.c ****     out[pos] = (Frame->FrameType == FDCAN_REMOTE_FRAME) ? 'r' : 't';
 576:../Src/slcan.c ****     pos++;
 577:../Src/slcan.c ****     SLCAN_Hex(&out[pos], Frame->Id, 3U);
 578:../Src/slcan.c ****     pos += 3U;
 579:../Src/slcan.c ****   }
 580:../Src/slcan.c **** 
 581:../Src/slcan.c ****   out[pos] = (char)('0' + Frame->Dlc);
 582:../Src/slcan.c ****   pos++;
 583:../Src/slcan.c **** 
 584:../Src/slcan.c ****   if (Frame->FrameType != FDCAN_REMOTE_FRAME)
 585:../Src/slcan.c ****   {
 586:../Src/slcan.c ****     for (i = 0U; i < Frame->Dlc; i++)
 587:../Src/slcan.c ****     {
 588:../Src/slcan.c ****       SLCAN_Hex(&out[pos], Frame->Data[i], 2U);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccQpdfWz.s 			page 24


 589:../Src/slcan.c ****       pos += 2U;
 590:../Src/slcan.c ****     }
 591:../Src/slcan.c ****   }
 592:../Src/slcan.c **** 
 593:../Src/slcan.c ****   if (SlcanTimestamp != 0U)
 594:../Src/slcan.c ****   {
 595:../Src/slcan.c ****     SLCAN_Hex(&out[pos], HAL_GetTick() % SLCAN_TIMESTAMP_MODULO, 4U);
 596:../Src/slcan.c ****     pos += 4U;
 597:../Src/slcan.c ****   }
 598:../Src/slcan.c **** 
 599:../Src/slcan.c ****   out[pos] = (char)SLCAN_CR;
 600:../Src/slcan.c ****   pos++;
 601:../Src/slcan.c **** 
 602:../Src/slcan.c ****   SLCAN_Queue(out, pos);
 603:../Src/slcan.c ****   HAL_GPIO_TogglePin(LED_PORT, LED_D1_PIN);
 604:../Src/slcan.c **** }
