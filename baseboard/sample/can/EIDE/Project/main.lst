  54:../Src/main.c ****   * @brief  Main program
  55:../Src/main.c ****   * @retval int
  56:../Src/main.c ****   */
  57:../Src/main.c **** int main(void)
  58:../Src/main.c **** {
  59:../Src/main.c ****   FDCAN_TxHeaderTypeDef TxHeader;
  60:../Src/main.c **** 
  61:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick */
  62:../Src/main.c ****   HAL_Init();
  63:../Src/main.c **** 
  64:../Src/main.c ****   /* System clock configuration: HSI 16 MHz / 2, PLL x20 /2 = 80 MHz SYSCLK */
  65:../Src/main.c ****   APP_SystemClockConfig();
  66:../Src/main.c **** 
  67:../Src/main.c ****   /* Initialize the board LEDs and the CAN transceiver standby pin */
  68:../Src/main.c ****   APP_GpioInit();
  69:../Src/main.c **** 
  70:../Src/main.c ****   /* Initialize FDCAN1 and the message RAM layout */
  71:../Src/main.c ****   APP_FdcanInit();
  72:../Src/main.c **** 
  73:../Src/main.c ****   /* Build the transmit header once, it is reused for every frame */
  74:../Src/main.c ****   TxHeader.Identifier          = CAN_TX_ID_STD;
  75:../Src/main.c ****   TxHeader.IdType              = FDCAN_STANDARD_ID;
  76:../Src/main.c ****   TxHeader.TxFrameType         = FDCAN_DATA_FRAME;
  77:../Src/main.c ****   TxHeader.DataLength          = FDCAN_DLC_BYTES_8;
  78:../Src/main.c ****   TxHeader.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  79:../Src/main.c ****   TxHeader.BitRateSwitch       = FDCAN_BRS_OFF;
  80:../Src/main.c ****   TxHeader.FDFormat            = FDCAN_CLASSIC_CAN;
  81:../Src/main.c ****   TxHeader.TxEventFifoControl  = FDCAN_NO_TX_EVENTS;
  82:../Src/main.c ****   TxHeader.MessageMarker       = 0U;
  83:../Src/main.c **** 
  84:../Src/main.c ****   while (1)
  85:../Src/main.c ****   {
  86:../Src/main.c ****     /* Update the payload so every frame is distinguishable on the bus */
  87:../Src/main.c ****     CanTxData[0] = (uint8_t)(CanTxCounter & 0xFFU);
  88:../Src/main.c ****     CanTxData[1] = (uint8_t)((CanTxCounter >> 8) & 0xFFU);
ARM GAS  C:\Users\user\AppData\Local\Temp\ccWhOIm1.s 			page 3


  89:../Src/main.c **** 
  90:../Src/main.c ****     /* Transmit one classic CAN frame -------------------------------------- */
  91:../Src/main.c ****     if (HAL_FDCAN_AddMessageToTxFifoQ(&FdcanHandle, &TxHeader, CanTxData) != HAL_OK)
  92:../Src/main.c ****     {
  93:../Src/main.c ****       APP_ErrorHandler();
  94:../Src/main.c ****     }
  95:../Src/main.c ****     CanTxCounter++;
  96:../Src/main.c **** 
  97:../Src/main.c ****     /* Toggle LED D1 so the transmit loop is visible without an analyser */
  98:../Src/main.c ****     HAL_GPIO_TogglePin(LED_PORT, LED_D1_PIN);
  99:../Src/main.c **** 
 100:../Src/main.c ****     /* Wait ~1 s before sending the next frame */
 101:../Src/main.c ****     HAL_Delay(1000);
 102:../Src/main.c ****   }
 103:../Src/main.c **** }
