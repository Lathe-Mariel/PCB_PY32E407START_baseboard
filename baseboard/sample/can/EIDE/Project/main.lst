  37:../Src/main.c **** /**
  38:../Src/main.c ****   * @brief  Main program
  39:../Src/main.c ****   * @retval int
  40:../Src/main.c ****   */
  41:../Src/main.c **** int main(void)
  42:../Src/main.c **** {
  43:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick */
  44:../Src/main.c ****   HAL_Init();
  45:../Src/main.c **** 
  46:../Src/main.c ****   /* System clock configuration: HSI 16 MHz / 2, PLL x20 /2 = 80 MHz SYSCLK */
  47:../Src/main.c ****   APP_SystemClockConfig();
  48:../Src/main.c **** 
  49:../Src/main.c ****   /* Initialize the board LEDs and the CAN transceiver standby pin */
  50:../Src/main.c ****   APP_GpioInit();
  51:../Src/main.c **** 
  52:../Src/main.c ****   /* Initialize the SLCAN link (USART1) and FDCAN1, CAN stays closed until
  53:../Src/main.c ****      the host sends 'O' or 'L' */
  54:../Src/main.c ****   SLCAN_Init();
  55:../Src/main.c **** 
  56:../Src/main.c ****   while (1)
  57:../Src/main.c ****   {
  58:../Src/main.c ****     SLCAN_Poll();
  59:../Src/main.c ****   }
  60:../Src/main.c **** }
