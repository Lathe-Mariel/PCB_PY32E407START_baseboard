   1:../Src/main.c **** /**
   2:../Src/main.c ****   ******************************************************************************
   3:../Src/main.c ****   * @file    main.c
   4:../Src/main.c ****   * @author  MCU Application Team
   5:../Src/main.c ****   * @brief   SLCAN (LAWICEL) CAN adapter bridge.
   6:../Src/main.c ****   *
   7:../Src/main.c ****   *          PC --UART(SLCAN ASCII)--> USART1 --FDCAN1--> ATA6561 --> CAN bus
   8:../Src/main.c ****   *
   9:../Src/main.c ****   *          The board behaves like a CANable / CANUSB style adapter: the host
  10:../Src/main.c ****   *          opens the virtual COM port, sends the SLCAN command set and the
  11:../Src/main.c ****   *          firmware forwards the frames to the on-board CAN transceiver.
  12:../Src/main.c ****   ******************************************************************************
  13:../Src/main.c ****   * @attention
  14:../Src/main.c ****   *
  15:../Src/main.c ****   * <h2><center>&copy; Copyright (c) 2023 Puya Semiconductor Co.
  16:../Src/main.c ****   * All rights reserved.</center></h2>
  17:../Src/main.c ****   *
  18:../Src/main.c ****   * This software component is licensed by Puya under BSD 3-Clause license,
  19:../Src/main.c ****   * the "License"; You may not use this file except in compliance with the
  20:../Src/main.c ****   * License. You may obtain a copy of the License at:
  21:../Src/main.c ****   *                        opensource.org/licenses/BSD-3-Clause
  22:../Src/main.c ****   *
  23:../Src/main.c ****   ******************************************************************************
  24:../Src/main.c ****   */
  25:../Src/main.c **** 
