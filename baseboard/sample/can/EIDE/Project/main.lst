 135:../Src/main.c **** /**
ARM GAS  C:\Users\user\AppData\Local\Temp\ccWhOIm1.s 			page 6


 136:../Src/main.c ****   * @brief  System clock configuration function.
 137:../Src/main.c ****   *         HSI(16 MHz)/2 * 20 = 160 MHz VCO, then /2 -> 80 MHz SYSCLK.
 138:../Src/main.c ****   *         80 MHz is used so the CAN kernel clock (PLL/1 = 80 MHz) divides
 139:../Src/main.c ****   *         cleanly into a 500 kbit/s CAN bit time.
 140:../Src/main.c ****   * @param  None
 141:../Src/main.c ****   * @retval None
 142:../Src/main.c ****   */
 143:../Src/main.c **** static void APP_SystemClockConfig(void)
 144:../Src/main.c **** {
 145:../Src/main.c ****   RCC_OscInitTypeDef  OscInitstruct = {0};
 146:../Src/main.c ****   RCC_ClkInitTypeDef  ClkInitstruct = {0};
 147:../Src/main.c **** 
 148:../Src/main.c ****   OscInitstruct.OscillatorType  = RCC_OSCILLATORTYPE_HSI;
 149:../Src/main.c ****   OscInitstruct.HSIState        = RCC_HSI_ON;                               /* Enable HSI */
 150:../Src/main.c ****   OscInitstruct.HSEState        = RCC_HSE_OFF;                              /* Close HSE */
 151:../Src/main.c ****   OscInitstruct.HSI48MState     = RCC_HSI48M_OFF;                           /* Close HSI48M */
 152:../Src/main.c ****   OscInitstruct.LSEState        = RCC_LSE_OFF;                              /* Close LSE */
 153:../Src/main.c ****   OscInitstruct.LSIState        = RCC_LSI_OFF;                              /* Close LSI */
 154:../Src/main.c ****   OscInitstruct.PLL.PLLState    = RCC_PLL_ON;                               /* Enable PLL */
 155:../Src/main.c ****   OscInitstruct.PLL.PLLSource   = RCC_PLLSOURCE_HSI_DIV2;                   /* PLL clock source HSI
 156:../Src/main.c ****   OscInitstruct.PLL.PLLPrediv   = RCC_PLL_PREDIV_DIV1;                      /* PLL clock Prediv fac
 157:../Src/main.c ****   OscInitstruct.PLL.PLLMUL      = 20;                                       /* 8 MHz * 20 = 160 MHz
 158:../Src/main.c ****   OscInitstruct.PLL.PLLPostdiv  = RCC_PLL_POSTDIV_DIV2;                     /* 160 MHz / 2 = 80 MHz
 159:../Src/main.c ****   if (HAL_RCC_OscConfig(&OscInitstruct) != HAL_OK)
 160:../Src/main.c ****   {
 161:../Src/main.c ****     APP_ErrorHandler();
 162:../Src/main.c ****   }
 163:../Src/main.c **** 
 164:../Src/main.c ****   ClkInitstruct.ClockType       = RCC_CLOCKTYPE_SYSCLK | RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_PCLK1 |
 165:../Src/main.c ****   ClkInitstruct.SYSCLKSource    = RCC_SYSCLKSOURCE_PLLCLK;                  /* System clock selecti
 166:../Src/main.c ****   ClkInitstruct.AHBCLKDivider   = RCC_SYSCLK_DIV1;                          /* AHB clock = 80 MHz *
 167:../Src/main.c ****   ClkInitstruct.APB1CLKDivider  = RCC_HCLK_DIV1;                            /* APB1 clock = 80 MHz 
 168:../Src/main.c ****   ClkInitstruct.APB2CLKDivider  = RCC_HCLK_DIV1;                            /* APB2 clock = 80 MHz 
 169:../Src/main.c ****   if (HAL_RCC_ClockConfig(&ClkInitstruct, FLASH_LATENCY_3) != HAL_OK)
 170:../Src/main.c ****   {
 171:../Src/main.c ****     APP_ErrorHandler();
 172:../Src/main.c ****   }
 173:../Src/main.c **** 
 174:../Src/main.c ****   /* Select the CAN kernel clock: PLL / 1 = 80 MHz.
 175:../Src/main.c ****      The APB (control logic) clock must be >= the CAN kernel clock, the
 176:../Src/main.c ****      configuration above keeps both at 80 MHz. */
 177:../Src/main.c ****   {
 178:../Src/main.c ****     RCC_PeriphCLKInitTypeDef PeriphClkInit = {0};
 179:../Src/main.c ****     PeriphClkInit.PeriphClockSelection = RCC_PERIPHCLK_CAN;
 180:../Src/main.c ****     PeriphClkInit.CanClockSelection    = RCC_CANCLKSOURCE_PLL;
 181:../Src/main.c ****     if (HAL_RCCEx_PeriphCLKConfig(&PeriphClkInit) != HAL_OK)
 182:../Src/main.c ****     {
 183:../Src/main.c ****       APP_ErrorHandler();
 184:../Src/main.c ****     }
 185:../Src/main.c ****   }
 186:../Src/main.c **** }
