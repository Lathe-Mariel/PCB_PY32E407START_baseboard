 734:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** /**
 735:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @brief Provide Rx Event type that has lead to RxEvent callback execution.
 736:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @note  When HAL_SCIEx_ReceiveToIdle_IT() or HAL_SCIEx_ReceiveToIdle_DMA() API are called, progr
 737:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        of reception process is provided to application through calls of Rx Event callback (eith
 738:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        HAL_SCIEx_RxEventCallback() or user registered one). As several types of events could oc
 739:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        Half Transfer, or Transfer Complete), this function allows to retrieve the Rx Event type
 740:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        to Rx Event callback execution.
 741:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @note  This function is expected to be called within the user implementation of Rx Event Callba
 742:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        in order to provide the accurate value :
 743:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        In Interrupt Mode :
 744:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *           - HAL_SCI_RXEVENT_TC : when Reception has been completed (expected nb of data has bee
 745:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *           - HAL_SCI_RXEVENT_IDLE : when Idle event occurred prior reception has been completed 
 746:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *             received data is lower than expected one)
 747:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        In DMA Mode :
 748:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *           - HAL_SCI_RXEVENT_TC : when Reception has been completed (expected nb of data has bee
 749:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *           - HAL_SCI_RXEVENT_HT : when half of expected nb of data has been received
 750:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *           - HAL_SCI_RXEVENT_IDLE : when Idle event occurred prior reception has been completed 
 751:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *             received data is lower than expected one).
 752:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        In DMA mode, RxEvent callback could be called several times;
 753:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        When DMA is configured in Normal Mode, HT event does not stop Reception process;
 754:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        When DMA is configured in Circular Mode, HT, TC or IDLE events don't stop Reception proc
 755:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @param  hsci SCI handle.
 756:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @retval Rx Event Type (return vale will be a value of @ref SCI_RxEvent_Type_Values)
 757:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   */
 758:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** HAL_SCI_RxEventTypeTypeDef HAL_SCIEx_GetRxEventType(const SCI_HandleTypeDef *hsci)
 759:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** {
 760:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Return Rx Event type value, as stored in SCI handle */
 761:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   return (hsci->RxEventType);
 762:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** }
