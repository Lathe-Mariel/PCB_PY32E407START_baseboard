 268:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 269:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** /**
 270:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @brief By default in multiprocessor mode, when the wake up method is set
 271:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        to address mark, the SCI handles only 4-bit long addresses detection;
 272:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        this API allows to enable longer addresses detection (6-, 7- or 8-bit
 273:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        long).
 274:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @note  Addresses detection lengths are: 6-bit address detection in 7-bit data mode,
 275:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *        7-bit address detection in 8-bit data mode, 8-bit address detection in 9-bit data mode.
 276:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @param hsci         SCI handle.
 277:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @param AddressLength This parameter can be one of the following values:
 278:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *          @arg @ref SCI_ADDRESS_DETECT_4B 4-bit long address
 279:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   *          @arg @ref SCI_ADDRESS_DETECT_7B 6-, 7- or 8-bit long address
 280:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @retval HAL status
 281:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   */
 282:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** HAL_StatusTypeDef HAL_SCI_MultiProcessorEx_AddressLength_Set(SCI_HandleTypeDef *hsci, uint32_t Addr
 283:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** {
 284:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Check the SCI handle allocation */
 285:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   if (hsci == NULL)
 286:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   {
 287:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****     return HAL_ERROR;
 288:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   }
 289:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 290:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Check the address length parameter */
 291:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   assert_param(IS_SCI_ADDRESSLENGTH_DETECT(AddressLength));
 292:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 293:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->gState = HAL_SCI_STATE_BUSY;
 294:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 295:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Disable the Peripheral */
 296:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_SCI_DISABLE(hsci);
 297:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 298:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Set the address length */
 299:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   MODIFY_REG(hsci->Instance->CR2, USART_CR1_ADDM7, AddressLength);
 300:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 301:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Enable the Peripheral */
 302:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_SCI_ENABLE(hsci);
 303:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 304:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Initialize the SCI State */
 305:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->gState  = HAL_SCI_STATE_READY;
 306:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->RxState = HAL_SCI_STATE_READY;
 307:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   
 308:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_UNLOCK(hsci);
 309:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 310:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   return HAL_OK;
 311:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** }
 312:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
