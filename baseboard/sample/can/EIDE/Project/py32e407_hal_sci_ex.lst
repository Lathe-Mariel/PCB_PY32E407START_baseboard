 147:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 148:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Perform advanced settings configuration */
 149:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* For some items, configuration requires to be done prior TE and RE bits are set */
 150:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   if (hsci->AdvancedInit.AdvFeatureInit != SCI_ADVFEATURE_NO_INIT)
