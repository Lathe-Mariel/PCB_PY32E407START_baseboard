 316:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   * @retval HAL status
 317:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   */
 318:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** HAL_StatusTypeDef HAL_SCIEx_EnableFifoMode(SCI_HandleTypeDef *hsci)
 319:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** {
 320:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   uint32_t tmpcr1;
 321:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 322:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Check parameters */
 323:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   assert_param(IS_SCI_FIFO_INSTANCE(hsci->Instance));
 324:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 325:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Process Locked */
 326:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_LOCK(hsci);
 327:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 328:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->gState = HAL_SCI_STATE_BUSY;
 329:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 330:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Save actual SCI configuration */
 331:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   tmpcr1 = READ_REG(hsci->Instance->CR1);
 332:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 333:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Disable SCI */
 334:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_SCI_DISABLE(hsci);
 335:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 336:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Enable FIFO mode */
 337:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   SET_BIT(tmpcr1, USART_CR1_FIFOEN);
 338:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->FifoMode = SCI_FIFOMODE_ENABLE;
 339:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 340:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Restore SCI configuration */
 341:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   WRITE_REG(hsci->Instance->CR1, tmpcr1);
 342:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 343:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Determine the number of data to process during RX/TX SR execution */
 344:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   SCIEx_SetNbDataToProcess(hsci);
 345:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 346:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   hsci->gState = HAL_SCI_STATE_READY;
 347:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 348:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Process Unlocked */
 349:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   __HAL_UNLOCK(hsci);
 350:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 351:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   return HAL_OK;
 352:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** }
