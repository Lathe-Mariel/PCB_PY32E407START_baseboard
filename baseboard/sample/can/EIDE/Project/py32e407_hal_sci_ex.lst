 155:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Set the SCI Communication parameters */
 156:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   SCI_SetConfig(hsci);
 157:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 158:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Enable the Driver Enable mode by setting the DEM bit in the CR2 register */
 159:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   SET_BIT(hsci->Instance->CR3, USART_CR2_DEM);
 160:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 161:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Set the Driver Enable polarity */
 162:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   MODIFY_REG(hsci->Instance->CR3, USART_CR2_DEP, Polarity);
 163:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 164:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Set the Driver Enable assertion and deassertion times */
 165:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   temp = (AssertionTime << SCI_CR3_DEAT_ADDRESS_LSB_POS);
 166:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   temp |= (DeassertionTime << SCI_CR3_DEDT_ADDRESS_LSB_POS);
 167:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   MODIFY_REG(hsci->Instance->CR1, (USART_CR3_DEDT | USART_CR3_DEAT), temp);
 168:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c **** 
 169:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci_ex.c ****   /* Enable the Peripheral */
