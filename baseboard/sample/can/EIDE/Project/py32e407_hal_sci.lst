2228:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         /* Disable the DMA transfer for the receiver request by resetting the DMAR bit
2229:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****            in the USART CR3 register */
2230:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         CLEAR_BIT(hsci->Instance->CR3, USART_CR3_DMAR);
