2826:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param  hsci  Pointer to a SCI_HandleTypeDef structure that contains
2827:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *                the configuration information for the specified SCI module.
2828:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @retval None
2829:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   */
2830:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** void SCI_SetConfig(SCI_HandleTypeDef *hsci)
2831:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** {
2832:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   uint32_t tmpreg;
2833:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   uint64_t clockfreq;
2834:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2835:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Check the parameters */
2836:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_BAUDRATE(hsci->Init.BaudRate));
2837:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_WORD_LENGTH(hsci->Init.WordLength));
2838:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_STOPBITS(hsci->Init.StopBits));
2839:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_PARITY(hsci->Init.Parity));
2840:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_MODE(hsci->Init.Mode));
2841:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_HARDWARE_FLOW_CONTROL(hsci->Init.HwFlowCtl));
2842:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_OVERSAMPLING(hsci->Init.OverSampling));
2843:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2844:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /*-------------------------- USART CR1 Configuration -----------------------*/
2845:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Configure the SCI Word Length, Parity and mode:
2846:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      Set the M bits according to hsci->Init.WordLength value
2847:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      Set PCE and PS bits according to hsci->Init.Parity value
2848:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      Set TE and RE bits according to hsci->Init.Mode value */
2849:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   
2850:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   tmpreg  = (uint32_t)hsci->Init.WordLength | hsci->Init.Parity | hsci->Init.Mode;
2851:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   tmpreg |= (uint32_t)hsci->FifoMode;
2852:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->CR1,SCI_CR1_FIELDS,tmpreg);
2853:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2854:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /*---------------------------- USART CR2 Configuration ---------------------*/
2855:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Configure the SCI Stop Bits: Set STOP[13:12] bits according
2856:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * to hsci->Init.StopBits value */
2857:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->CR2, USART_CR2_STOP, hsci->Init.StopBits);
2858:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2859:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /*-------------------------- USART CR3 Configuration -----------------------*/
2860:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Configure the SCI HFC: Set CTSE and RTSE bits according to hsci->Init.HwFlowCtl value
2861:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      Set OVER8 bit according to hsci->Init.OverSampling value */
2862:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->CR3, (USART_CR3_RTSE | USART_CR3_CTSE), hsci->Init.HwFlowCtl);
2863:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->CR3, (uint32_t)(USART_CR3_OVER8), (uint32_t) hsci->Init.OverSampling);
2864:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2865:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /*-------------------------- USART BRR Configuration -----------------------*/
2866:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   if(hsci->Instance == USART1)
2867:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
2868:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     clockfreq = HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_USART1);
2869:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   }
2870:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   else if(hsci->Instance == USART2)
2871:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
2872:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     clockfreq = HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_USART2);
2873:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   }
2874:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   else if(hsci->Instance == USART3)
2875:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
2876:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     clockfreq = HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_USART3);
2877:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   }
2878:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   else
2879:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
2880:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   }
