2544:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     [..]
2545:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     This subsection provides a set of functions allowing to control the SCI.
2546:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_SCI_ReceiverTimeout_Config() API allows to configure the receiver timeout value on the
2547:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_SCI_EnableReceiverTimeout() API enables the receiver timeout feature
2548:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_SCI_DisableReceiverTimeout() API disables the receiver timeout feature
2549:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) SCI_SetConfig() API configures the SCI peripheral
2550:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) SCI_AdvFeatureConfig() API optionally configures the SCI advanced features
2551:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_HalfDuplex_EnableTransmitter() API disables receiver and enables transmitter
2552:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_HalfDuplex_EnableReceiver() API disables transmitter and enables receiver
2553:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****      (+) HAL_LIN_SendBreak() API transmits the break characters
2554:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** @endverbatim
