 431:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Perform advanced settings configuration */
 432:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* For some items, configuration requires to be done prior TE and RE bits are set */
 433:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   if (hsci->AdvancedInit.AdvFeatureInit != SCI_ADVFEATURE_NO_INIT)
 434:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
 435:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     SCI_AdvFeatureConfig(hsci);
