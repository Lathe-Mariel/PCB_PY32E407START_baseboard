2243:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         hsci->RxEventType = HAL_SCI_RXEVENT_IDLE;
2244:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
