2593:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     /* Process Unlocked */
2594:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     __HAL_UNLOCK(hsci);
