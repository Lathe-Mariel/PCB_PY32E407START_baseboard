2882:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Check the Over Sampling */
2883:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   if(hsci->Init.OverSampling == SCI_OVERSAMPLING_8)
