 437:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
 438:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Set the SCI Communication parameters */
 439:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   SCI_SetConfig(hsci);
 440:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
 441:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* In multiprocessor mode, the following bits must be kept cleared:
 442:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   - LINEN and CLKEN bits in the USART_CR2 register,
 443:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   - SCEN, HDSEL and IREN  bits in the USART_CR3 register. */
 444:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   CLEAR_BIT(hsci->Instance->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN));
 445:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   CLEAR_BIT(hsci->Instance->CR3, (USART_CR3_SCEN | USART_CR3_HDSEL | USART_CR3_IREN));
 446:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
 447:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   if (WakeUpMethod == SCI_WAKEUPMETHOD_ADDRESSMARK)
 448:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   {
 449:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     /* If address mark wake up method is chosen, set the SCI address node */
 450:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     MODIFY_REG(hsci->Instance->CR2, USART_CR2_ADD, ((uint32_t)Address << 15));
 451:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   }
 452:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
 453:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   /* Set the wake up method by setting the WAKE bit in the CR1 register */
 454:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->CR1, USART_CR1_WAKE, WakeUpMethod);
 455:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
 456:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   __HAL_SCI_ENABLE(hsci);
 457:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
