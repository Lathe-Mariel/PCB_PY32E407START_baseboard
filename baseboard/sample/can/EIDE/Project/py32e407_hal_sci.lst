2557:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2558:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** /**
2559:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @brief  Update on the fly the receiver timeout value in RTOR register.
2560:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param  hsci Pointer to a SCI_HandleTypeDef structure that contains
2561:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *                    the configuration information for the specified SCI module.
2562:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param  TimeoutValue receiver timeout value in number of baud blocks. The timeout
2563:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *                     value must be less or equal to 0x0FFFFFFFF.
2564:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @retval None
2565:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   */
2566:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** void HAL_SCI_ReceiverTimeout_Config(SCI_HandleTypeDef *hsci, uint32_t TimeoutValue)
2567:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** {
2568:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   assert_param(IS_SCI_RECEIVER_TIMEOUT_VALUE(TimeoutValue));
2569:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   MODIFY_REG(hsci->Instance->RTOR, USART_RTOR_RTO, TimeoutValue);
