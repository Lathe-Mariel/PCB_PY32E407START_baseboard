 373:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** /**
 374:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @brief Initialize the multiprocessor mode according to the specified
 375:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        parameters in the SCI_InitTypeDef and initialize the associated handle.
 376:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param hsci        SCI handle.
 377:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param Address      SCI node address (4-, 6-, 7- or 8-bit long).
 378:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @param WakeUpMethod Specifies the SCI wakeup method.
 379:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        This parameter can be one of the following values:
 380:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *          @arg @ref SCI_WAKEUPMETHOD_IDLELINE WakeUp by an idle line detection
 381:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *          @arg @ref SCI_WAKEUPMETHOD_ADDRESSMARK WakeUp by an address mark
 382:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @note  If the user resorts to idle line detection wake up, the Address parameter
 383:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        is useless and ignored by the initialization function.
 384:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @note  If the user resorts to address mark wake up, the address length detection
 385:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        is configured by default to 4 bits only. For the SCI to be able to
 386:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        manage 6-, 7- or 8-bit long addresses detection, the API
 387:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        HAL_MultiProcessorEx_AddressLength_Set() must be called after
 388:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   *        HAL_MultiProcessor_Init().
 389:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   * @retval HAL status
 390:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   */
 391:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** HAL_StatusTypeDef HAL_MultiProcessor_Init(SCI_HandleTypeDef *hsci, uint8_t Address, uint32_t WakeUp
 392:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** {
