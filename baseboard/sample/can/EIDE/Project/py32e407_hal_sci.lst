2222:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         hsci->RxXferCount = nb_remaining_rx_data;
2223:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** 
2224:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         /* Disable PE and ERR (Frame error, noise error, overrun error) interrupts */
