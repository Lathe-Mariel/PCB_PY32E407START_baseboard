1358:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****     if ((hsci->Init.WordLength == SCI_WORDLENGTH_9B) && (hsci->Init.Parity == SCI_PARITY_NONE))
