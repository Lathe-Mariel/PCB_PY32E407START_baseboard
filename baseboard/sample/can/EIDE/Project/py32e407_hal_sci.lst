2579:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** HAL_StatusTypeDef HAL_SCI_EnableReceiverTimeout(SCI_HandleTypeDef *hsci)
2580:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c **** {
2581:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   if (hsci->gState == HAL_SCI_STATE_READY)
