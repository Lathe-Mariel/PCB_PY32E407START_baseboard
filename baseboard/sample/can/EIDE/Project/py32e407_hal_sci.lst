2238:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         /* Last bytes received, so no need as the abort is immediate */
2239:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****         (void)HAL_DMA_Abort(hsci->hdmarx);
