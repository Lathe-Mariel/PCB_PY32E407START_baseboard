 460:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   hsci->gState = HAL_SCI_STATE_READY;
 461:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_sci.c ****   hsci->RxState = HAL_SCI_STATE_READY;
