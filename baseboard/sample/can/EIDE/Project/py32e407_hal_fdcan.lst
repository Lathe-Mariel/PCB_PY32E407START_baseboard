2883:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     }
2884:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
2885:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     if ((ActiveITs & FDCAN_IT_TX_COMPLETE) != 0U)
2886:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     {
2887:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       /* Enable Tx Buffer Transmission Interrupt to set TC flag in IR register,
2888:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****          but interrupt will only occur if TC is enabled in IE register */
