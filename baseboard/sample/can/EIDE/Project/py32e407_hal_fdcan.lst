1969:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   * @brief  Stop the FDCAN module and enable access to configuration registers.
1970:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   * @param  hfdcan pointer to an FDCAN_HandleTypeDef structure that contains
1971:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   *         the configuration information for the specified FDCAN.
1972:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   * @retval HAL status
1973:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   */
1974:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** HAL_StatusTypeDef HAL_FDCAN_Stop(FDCAN_HandleTypeDef *hfdcan)
1975:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** {
1976:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   uint32_t Counter = 0U;
1977:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
1978:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   if (hfdcan->State == HAL_FDCAN_STATE_BUSY)
1979:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****   {
1980:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     /* Request initialisation */
1981:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     SET_BIT(hfdcan->Instance->CCCR, FDCAN_CCCR_INIT);
1982:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
1983:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     /* Wait until the INIT bit into CCCR register is set */
1984:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     while ((hfdcan->Instance->CCCR & FDCAN_CCCR_INIT) == 0U)
1985:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****     {
1986:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       /* Check for the Timeout */
1987:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       if (Counter > FDCAN_TIMEOUT_COUNT)
1988:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       {
1989:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****         /* Update error code */
1990:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****         hfdcan->ErrorCode |= HAL_FDCAN_ERROR_TIMEOUT;
1991:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
1992:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****         /* Change FDCAN state */
1993:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****         hfdcan->State = HAL_FDCAN_STATE_ERROR;
1994:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
1995:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****         return HAL_ERROR;
1996:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       }
1997:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c **** 
1998:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       /* Increment counter */
1999:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_fdcan.c ****       Counter++;
