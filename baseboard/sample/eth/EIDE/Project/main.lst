  66:../Src/main.c ****   * @brief  Main program
  67:../Src/main.c ****   * @retval int
  68:../Src/main.c ****   */
  69:../Src/main.c **** int main(void)
  70:../Src/main.c **** {
  71:../Src/main.c ****   LAN8670_Info info = {0};
  72:../Src/main.c ****   LAN8670_Status status;
  73:../Src/main.c ****   uint8_t ethReady = 0U;
  74:../Src/main.c ****   uint32_t lastTx = 0U;
  75:../Src/main.c **** 
  76:../Src/main.c ****   HAL_Init();
  77:../Src/main.c ****   APP_SystemClockConfig();
  78:../Src/main.c ****   APP_GpioInit();
  79:../Src/main.c ****   Console_Init();
  80:../Src/main.c **** 
  81:../Src/main.c ****   Console_Write("\r\n=== PY32E407 + LAN8670 10BASE-T1S bring-up ===\r\n");
  82:../Src/main.c **** 
  83:../Src/main.c ****   /* ------------------------------------------------- MAC/DMA (no start) ---*/
  84:../Src/main.c ****   /* This must happen first: it enables the ETH clock, configures the RMII
  85:../Src/main.c ****      pins and programs the MDIO clock range used by every PHY access below. */
  86:../Src/main.c ****   if (LAN8670_EthInit() != HAL_OK)
  87:../Src/main.c ****   {
  88:../Src/main.c ****     Console_Write("MAC: initialisation FAILED (RMII clock missing?)\r\n");
  89:../Src/main.c ****     Console_Write("     check the 50 MHz oscillator and R6/R38/R39/R40\r\n");
  90:../Src/main.c ****     while (1)
  91:../Src/main.c ****     {
  92:../Src/main.c ****       HAL_GPIO_TogglePin(LED_PORT, LED_D1_PIN);
  93:../Src/main.c ****       HAL_Delay(200U);
  94:../Src/main.c ****     }
  95:../Src/main.c ****   }
  96:../Src/main.c ****   Console_Write("MAC: ETH clock, RMII pins and MDIO ready\r\n");
  97:../Src/main.c **** 
  98:../Src/main.c ****   /* ---------------------------------------------------------------- PHY ---*/
  99:../Src/main.c ****   status = LAN8670_Probe(&info);
 100:../Src/main.c ****   APP_PrintPhyInfo(&info);
 101:../Src/main.c **** 
 102:../Src/main.c ****   if (status == LAN8670_ERR_MDIO)
 103:../Src/main.c ****   {
 104:../Src/main.c ****     Console_Write("PHY: no answer on MDIO (check PHYAD strap / MDIO pull-up)\r\n");
 105:../Src/main.c ****   }
 106:../Src/main.c ****   else if (status == LAN8670_ERR_ID)
 107:../Src/main.c ****   {
 108:../Src/main.c ****     Console_Write("PHY: answered but the identifier is not a LAN8670\r\n");
 109:../Src/main.c ****   }
 110:../Src/main.c ****   else
 111:../Src/main.c ****   {
 112:../Src/main.c ****     Console_Write("PHY: LAN8670 detected\r\n");
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cckQ49Ty.s 			page 4


 113:../Src/main.c ****   }
 114:../Src/main.c **** 
 115:../Src/main.c ****   if (status == LAN8670_OK)
 116:../Src/main.c ****   {
 117:../Src/main.c ****     /* ------------------------------------------------------ PHY reset ---*/
 118:../Src/main.c ****     status = LAN8670_SoftReset();
 119:../Src/main.c ****     Console_Printf("PHY: soft reset %s\r\n",
 120:../Src/main.c ****                    (status == LAN8670_OK) ? "OK" : "FAILED");
 121:../Src/main.c **** 
 122:../Src/main.c ****     /* ----------------------------------------------------------- PLCA ---*/
 123:../Src/main.c ****     status = LAN8670_ConfigurePLCA(PLCA_NODE_ID, PLCA_NODE_COUNT, PLCA_TOTMR);
 124:../Src/main.c ****     if (status == LAN8670_OK)
 125:../Src/main.c ****     {
 126:../Src/main.c ****       Console_Printf("PHY: PLCA enabled, ID=%u, node count=%u, TOTMR=%u\r\n",
 127:../Src/main.c ****                      (unsigned)PLCA_NODE_ID, (unsigned)PLCA_NODE_COUNT,
 128:../Src/main.c ****                      (unsigned)PLCA_TOTMR);
 129:../Src/main.c ****     }
 130:../Src/main.c ****     else
 131:../Src/main.c ****     {
 132:../Src/main.c ****       Console_Write("PHY: PLCA configuration FAILED\r\n");
 133:../Src/main.c ****     }
 134:../Src/main.c **** 
 135:../Src/main.c ****     /* ------------------------------------------------------- MAC start ---*/
 136:../Src/main.c ****     if (LAN8670_EthStart() == HAL_OK)
 137:../Src/main.c ****     {
 138:../Src/main.c ****       ethReady = 1U;
 139:../Src/main.c ****       Console_Write("MAC: RMII 10 Mbit/s full duplex, DMA started\r\n");
 140:../Src/main.c ****     }
 141:../Src/main.c ****     else
 142:../Src/main.c ****     {
 143:../Src/main.c ****       Console_Write("MAC: start FAILED\r\n");
 144:../Src/main.c ****     }
 145:../Src/main.c **** 
 146:../Src/main.c ****     /* ----------------------------------------------------------- link ---*/
 147:../Src/main.c ****     if (ethReady != 0U)
 148:../Src/main.c ****     {
 149:../Src/main.c ****       status = LAN8670_WaitForLink(3000U);
 150:../Src/main.c ****       Console_Printf("PHY: link %s\r\n",
 151:../Src/main.c ****                      (status == LAN8670_OK) ? "UP" : "DOWN (no partner?)");
 152:../Src/main.c ****     }
 153:../Src/main.c ****   }
 154:../Src/main.c **** 
 155:../Src/main.c ****   Console_Write("Ready. Sending a demo frame every second.\r\n\r\n");
 156:../Src/main.c **** 
 157:../Src/main.c ****   /* -------------------------------------------------------------- loop ---*/
 158:../Src/main.c ****   while (1)
 159:../Src/main.c ****   {
 160:../Src/main.c ****     uint8_t  frame[ETH_MAX_PACKET_SIZE];
 161:../Src/main.c ****     uint32_t length = 0U;
 162:../Src/main.c **** 
 163:../Src/main.c ****     /* Frames coming from the segment */
 164:../Src/main.c ****     while (LAN8670_GetFrame(frame, sizeof(frame), &length) == HAL_OK)
 165:../Src/main.c ****     {
 166:../Src/main.c ****       HAL_GPIO_TogglePin(LED_PORT, LED_D2_PIN);
 167:../Src/main.c ****       APP_PrintReceivedFrame(frame, length);
 168:../Src/main.c ****     }
 169:../Src/main.c **** 
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cckQ49Ty.s 			page 5


 170:../Src/main.c ****     /* Periodic demo frame so the segment shows traffic */
 171:../Src/main.c ****     if ((HAL_GetTick() - lastTx) >= DEMO_FRAME_PERIOD_MS)
 172:../Src/main.c ****     {
 173:../Src/main.c ****       lastTx = HAL_GetTick();
 174:../Src/main.c ****       HAL_GPIO_TogglePin(LED_PORT, LED_D4_PIN);
 175:../Src/main.c **** 
 176:../Src/main.c ****       if (ethReady != 0U)
 177:../Src/main.c ****       {
 178:../Src/main.c ****         APP_SendDemoFrame();
 179:../Src/main.c ****       }
 180:../Src/main.c ****     }
 181:../Src/main.c ****   }
 182:../Src/main.c **** }
