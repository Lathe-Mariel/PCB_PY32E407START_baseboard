  30:../Src/main.c ****   */
  31:../Src/main.c **** 
  32:../Src/main.c **** /* Includes ------------------------------------------------------------------*/
  33:../Src/main.c **** #include <string.h>
  34:../Src/main.c **** 
  35:../Src/main.c **** #include "main.h"
  36:../Src/main.c **** #include "lan8670.h"
  37:../Src/main.c **** 
  38:../Src/main.c **** /* Private define ------------------------------------------------------------*/
  39:../Src/main.c **** 
  40:../Src/main.c **** /*
  41:../Src/main.c ****  * PLCA configuration.
  42:../Src/main.c ****  * Exactly one node on the mixing segment is the coordinator (ID 0) and sends
  43:../Src/main.c ****  * the periodic BEACON. Followers take IDs 1..NodeCount-1.
  44:../Src/main.c ****  */
  45:../Src/main.c **** #define PLCA_NODE_ID                  0U    /* 0 = coordinator, 1..254 = follower */
  46:../Src/main.c **** #define PLCA_NODE_COUNT               8U
  47:../Src/main.c **** #define PLCA_TOTMR                   32U   /* transmit opportunity timer, 0 = default */
  48:../Src/main.c **** 
  49:../Src/main.c **** /* Demo traffic */
  50:../Src/main.c **** #define DEMO_FRAME_PERIOD_MS         1000U
  51:../Src/main.c **** #define DEMO_FRAME_LEN               20U
  52:../Src/main.c **** 
  53:../Src/main.c **** /* Private variables ---------------------------------------------------------*/
  54:../Src/main.c **** ETH_HandleTypeDef heth;
  55:../Src/main.c **** 
