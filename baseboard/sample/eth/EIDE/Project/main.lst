 184:../Src/main.c **** /**
 185:../Src/main.c ****   * @brief  Build and transmit one demo frame.
 186:../Src/main.c ****   */
 187:../Src/main.c **** static void APP_SendDemoFrame(void)
 188:../Src/main.c **** {
 189:../Src/main.c ****   uint8_t frame[DEMO_FRAME_LEN];
 190:../Src/main.c ****   static const uint8_t src[6] = {0x02U, 0x00U, 0x00U, 0x00U, 0x00U, 0x01U};
 191:../Src/main.c ****   static const uint8_t dst[6] = {0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFFU, 0xFFU};
 192:../Src/main.c ****   uint32_t i;
 193:../Src/main.c **** 
 194:../Src/main.c ****   /* Ethernet header */
 195:../Src/main.c ****   for (i = 0U; i < 6U; i++)
 196:../Src/main.c ****   {
 197:../Src/main.c ****     frame[i]      = dst[i];
 198:../Src/main.c ****     frame[6U + i] = src[i];
 199:../Src/main.c ****   }
 200:../Src/main.c ****   frame[12] = (uint8_t)(DEMO_ETHERTYPE >> 8U);
 201:../Src/main.c ****   frame[13] = (uint8_t)(DEMO_ETHERTYPE & 0xFFU);
 202:../Src/main.c **** 
 203:../Src/main.c ****   /* Payload: sequence number + a few counters */
 204:../Src/main.c ****   DemoTxCounter++;
 205:../Src/main.c ****   frame[14] = (uint8_t)(DemoTxCounter >> 24U);
 206:../Src/main.c ****   frame[15] = (uint8_t)(DemoTxCounter >> 16U);
 207:../Src/main.c ****   frame[16] = (uint8_t)(DemoTxCounter >> 8U);
 208:../Src/main.c ****   frame[17] = (uint8_t)(DemoTxCounter);
 209:../Src/main.c ****   frame[18] = (uint8_t)(HAL_GetTick() >> 8U);
 210:../Src/main.c ****   frame[19] = (uint8_t)(HAL_GetTick());
 211:../Src/main.c **** 
 212:../Src/main.c ****   if (LAN8670_SendFrame(frame, DEMO_FRAME_LEN) == HAL_OK)
 213:../Src/main.c ****   {
 214:../Src/main.c ****     HAL_GPIO_TogglePin(LED_PORT, LED_D3_PIN);
 215:../Src/main.c ****     Console_Printf("TX %lu bytes, seq=%lu\r\n",
 216:../Src/main.c ****                     (unsigned long)DEMO_FRAME_LEN, (unsigned long)DemoTxCounter);
 217:../Src/main.c ****   }
 218:../Src/main.c ****   else
 219:../Src/main.c ****   {
 220:../Src/main.c ****     Console_Write("TX failed (descriptor busy)\r\n");
 221:../Src/main.c ****   }
 222:../Src/main.c **** }
 223:../Src/main.c **** 
 224:../Src/main.c **** /**
 225:../Src/main.c ****   * @brief  Print the interesting fields of a received frame.
 226:../Src/main.c ****   */
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cckQ49Ty.s 			page 6


 227:../Src/main.c **** static void APP_PrintReceivedFrame(const uint8_t *Frame, uint32_t Length)
 228:../Src/main.c **** {
 229:../Src/main.c ****   uint16_t etherType;
 230:../Src/main.c ****   uint32_t i;
 231:../Src/main.c ****   uint32_t shown;
 232:../Src/main.c **** 
 233:../Src/main.c ****   if (Length < 14U)
 234:../Src/main.c ****   {
 235:../Src/main.c ****     Console_Printf("RX %lu bytes (runt)\r\n", (unsigned long)Length);
 236:../Src/main.c ****     return;
 237:../Src/main.c ****   }
 238:../Src/main.c **** 
 239:../Src/main.c ****   etherType = (uint16_t)(((uint16_t)Frame[12] << 8U) | Frame[13]);
 240:../Src/main.c **** 
 241:../Src/main.c ****   Console_Printf("RX %lu bytes type=0x%04X\r\n", (unsigned long)Length,
 242:../Src/main.c ****                  (unsigned)etherType);
 243:../Src/main.c ****   Console_Write("   ");
 244:../Src/main.c **** 
 245:../Src/main.c ****   shown = (Length - 14U < 16U) ? (Length - 14U) : 16U;
 246:../Src/main.c ****   for (i = 0U; i < shown; i++)
 247:../Src/main.c ****   {
 248:../Src/main.c ****     Console_Printf("%02X ", Frame[14U + i]);
 249:../Src/main.c ****   }
 250:../Src/main.c ****   Console_Write("\r\n");
 251:../Src/main.c **** }
