   1:../Src/lan8670.c **** /**
   2:../Src/lan8670.c ****   ******************************************************************************
   3:../Src/lan8670.c ****   * @file    lan8670.c
   4:../Src/lan8670.c ****   * @brief   LAN8670 10BASE-T1S PHY bring-up and PY32E407 ETH (RMII) driver.
   5:../Src/lan8670.c ****   *
   6:../Src/lan8670.c ****   *          The LAN8670 is connected to the PY32E407 ETH RMII pin set, so the
   7:../Src/lan8670.c ****   *          MAC side is driven by the on-chip ETH peripheral while the PHY is
   8:../Src/lan8670.c ****   *          configured through the MDIO management interface.
   9:../Src/lan8670.c ****   *
  10:../Src/lan8670.c ****   *            MDIO/MDC  -> Clause 22 registers 0x00..0x1F
  11:../Src/lan8670.c ****   *                         MMD registers through 0x0D/0x0E (DEVAD 1, 3, 31)
  12:../Src/lan8670.c ****   *
  13:../Src/lan8670.c ****   *          PLCA (Physical Layer Collision Avoidance) is the 10BASE-T1S
  14:../Src/lan8670.c ****   *          mechanism that makes a multidrop mixing segment deterministic.
  15:../Src/lan8670.c ****   *          One node must act as coordinator (PLCA ID 0) and periodically send
  16:../Src/lan8670.c ****   *          the BEACON; the other nodes are followers with IDs 1..N.
  17:../Src/lan8670.c ****   ******************************************************************************
  18:../Src/lan8670.c ****   */
  19:../Src/lan8670.c **** 
  20:../Src/lan8670.c **** /* Includes ------------------------------------------------------------------*/
  21:../Src/lan8670.c **** #include "lan8670.h"
  22:../Src/lan8670.c **** 
  23:../Src/lan8670.c **** /* Private define ------------------------------------------------------------*/
  24:../Src/lan8670.c **** #define ETH_RX_BUF_SIZE               ETH_MAX_PACKET_SIZE
  25:../Src/lan8670.c **** #define ETH_TX_BUF_SIZE               ETH_MAX_PACKET_SIZE
  26:../Src/lan8670.c **** 
  27:../Src/lan8670.c **** #define LAN8670_RESET_POLL_MS         100U
  28:../Src/lan8670.c **** #define LAN8670_LINK_POLL_MS         1000U
  29:../Src/lan8670.c **** 
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cc6gwIPB.s 			page 2


