 606:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Set Receive Descriptor List Address Register */
 607:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   (heth->Instance)->DMARDLAR = (uint32_t) DMARxDescTab;
 608:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 609:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Set ETH HAL State to Ready */
