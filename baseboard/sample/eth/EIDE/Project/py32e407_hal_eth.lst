 601:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****       /* For last descriptor, set next descriptor address register equal to the first descriptor ba
 602:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****       DMARxDesc->Buffer2NextDescAddr = (uint32_t)(DMARxDescTab);
