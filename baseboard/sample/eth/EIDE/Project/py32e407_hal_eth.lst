 573:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   for (i = 0U; i < RxBuffCount; i++)
 574:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   {
 575:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* Get the pointer on the ith member of the Rx Desc list */
 576:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     DMARxDesc = DMARxDescTab + i;
 577:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 578:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* Set Own bit of the Rx descriptor Status */
 579:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     DMARxDesc->Status = ETH_DMARXDESC_OWN;
 580:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 581:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* Set Buffer1 size and Second Address Chained bit */
 582:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     DMARxDesc->ControlBufferSize = ETH_DMARXDESC_RCH | ETH_RX_BUF_SIZE;
 583:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 584:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* Set Buffer1 address pointer */
 585:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     DMARxDesc->Buffer1Addr = (uint32_t)(&RxBuff[i * ETH_RX_BUF_SIZE]);
 586:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 587:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     if ((heth->Init).RxMode == ETH_RXINTERRUPT_MODE)
 588:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     {
 589:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****       /* Enable Ethernet DMA Rx Descriptor interrupt */
 590:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****       DMARxDesc->ControlBufferSize &= ~ETH_DMARXDESC_DIC;
 591:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     }
 592:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 593:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* Initialize the next descriptor with the Next Descriptor Polling Enable */
 594:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     if (i < (RxBuffCount - 1U))
 595:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     {
