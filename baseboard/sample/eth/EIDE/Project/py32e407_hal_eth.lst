 236:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Clear CSR Clock Range CR[2:0] bits */
 237:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   tmpreg1 &= ETH_MACMIIAR_CR_MASK;
 238:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 239:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Get hclk frequency value */
 240:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   hclk = HAL_RCC_GetHCLKFreq();
 241:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c **** 
 242:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Set CR bits depending on hclk value */
 243:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   if ((hclk >= 20000000U) && (hclk < 35000000U))
 244:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   {
 245:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* CSR Clock Range between 20-35 MHz */
 246:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     tmpreg1 |= (uint32_t)ETH_MACMIIAR_CR_DIV16;
 247:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   }
 248:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   else if ((hclk >= 35000000U) && (hclk < 60000000U))
 249:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   {
 250:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* CSR Clock Range between 35-60 MHz */
 251:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     tmpreg1 |= (uint32_t)ETH_MACMIIAR_CR_DIV26;
 252:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   }
 253:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   else
 254:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   {
 255:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     /* CSR Clock Range between 60-72 MHz */
 256:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****     tmpreg1 |= (uint32_t)ETH_MACMIIAR_CR_DIV42;
 257:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   }
