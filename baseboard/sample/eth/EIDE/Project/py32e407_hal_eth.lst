 233:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /*-------------------------------- MAC Initialization ----------------------*/
 234:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_eth.c ****   /* Get the ETHERNET MACMIIAR value */
