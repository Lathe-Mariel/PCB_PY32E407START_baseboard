 151:../Src/music.c ****      the carrier stays correct if the clock tree changes. */
 152:../Src/music.c ****   s_pwm_timer_clk_hz  = MUSIC_GetApb2TimerClock(HAL_RCC_GetPCLK2Freq());
 153:../Src/music.c ****   s_note_timer_clk_hz = MUSIC_GetApb1TimerClock(HAL_RCC_GetPCLK1Freq());
 154:../Src/music.c **** 
 155:../Src/music.c ****   /* TIM1 time base: prescaler 1, 256-count period (8 bit PWM DAC). */
 156:../Src/music.c ****   s_pwm.Instance               = MUSIC_PWM_TIM;
 157:../Src/music.c ****   s_pwm.Init.Prescaler         = 0U;
 158:../Src/music.c ****   s_pwm.Init.CounterMode       = TIM_COUNTERMODE_UP;
 159:../Src/music.c ****   s_pwm.Init.Period            = MUSIC_PWM_PERIOD - 1U;
 160:../Src/music.c ****   s_pwm.Init.ClockDivision     = TIM_CLOCKDIVISION_DIV1;
 161:../Src/music.c ****   s_pwm.Init.RepetitionCounter = 0U;
 162:../Src/music.c ****   s_pwm.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
 163:../Src/music.c ****   if (HAL_TIM_PWM_Init(&s_pwm) != HAL_OK)
 164:../Src/music.c ****   {
 165:../Src/music.c ****     APP_ErrorHandler();
 166:../Src/music.c ****   }
 167:../Src/music.c **** 
 168:../Src/music.c ****   /* PWM1 mode with complementary output. Both outputs are active high, so
 169:../Src/music.c ****      CH2N is the exact complement of CH2: the two buzzer terminals see
 170:../Src/music.c ****      opposite phases (differential drive). The duty changes per sample. */
 171:../Src/music.c ****   oc.OCMode       = TIM_OCMODE_PWM1;
 172:../Src/music.c ****   oc.Pulse        = 0U;                             /* 0 % duty = silence    */
 173:../Src/music.c ****   oc.OCPolarity   = TIM_OCPOLARITY_HIGH;
 174:../Src/music.c ****   oc.OCNPolarity  = TIM_OCNPOLARITY_HIGH;
 175:../Src/music.c ****   oc.OCFastMode   = TIM_OCFAST_DISABLE;
 176:../Src/music.c ****   oc.OCIdleState  = TIM_OCIDLESTATE_RESET;
 177:../Src/music.c ****   oc.OCNIdleState = TIM_OCNIDLESTATE_RESET;
