 187:../Src/music.c ****   bd.OffStateIDLEMode = TIM_OSSI_ENABLE;
 188:../Src/music.c ****   bd.LockLevel        = TIM_LOCKLEVEL_OFF;
 189:../Src/music.c ****   bd.DeadTime         = 0U;
 190:../Src/music.c ****   bd.BreakState       = TIM_BREAK_DISABLE;
 191:../Src/music.c ****   bd.BreakPolarity    = TIM_BREAKPOLARITY_LOW;
 192:../Src/music.c ****   bd.BreakFilter      = 0U;
 193:../Src/music.c ****   bd.AutomaticOutput  = TIM_AUTOMATICOUTPUT_DISABLE;
 194:../Src/music.c ****   bd.Break2State      = TIM_BREAK2_DISABLE;
 195:../Src/music.c ****   bd.Break2Polarity   = TIM_BREAK2POLARITY_LOW;
 196:../Src/music.c ****   bd.Break2Filter     = 0U;
