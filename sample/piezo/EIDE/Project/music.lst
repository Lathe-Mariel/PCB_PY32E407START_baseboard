  47:../Src/music.c **** 
  48:../Src/music.c **** /* Private define ------------------------------------------------------------*/
  49:../Src/music.c **** /**
  50:../Src/music.c ****   * @brief  Peripherals used by the player.
  51:../Src/music.c ****   *
  52:../Src/music.c ****   *         TIM1: APB2, PWM DAC carrier on PA9/PA12.
  53:../Src/music.c ****   *         TIM2: APB1, paces the PCM samples.
  54:../Src/music.c ****   */
  55:../Src/music.c **** #define MUSIC_PWM_TIM                 TIM1
  56:../Src/music.c **** #define MUSIC_NOTE_TIM                TIM2
  57:../Src/music.c **** #define MUSIC_NOTE_IRQn               TIM2_IRQn
  58:../Src/music.c **** 
  59:../Src/music.c **** #define MUSIC_PWM_TIM_CLK_ENABLE()    __HAL_RCC_TIM1_CLK_ENABLE()
  60:../Src/music.c **** #define MUSIC_NOTE_TIM_CLK_ENABLE()   __HAL_RCC_TIM2_CLK_ENABLE()
  61:../Src/music.c **** 
  62:../Src/music.c **** /**
  63:../Src/music.c ****   * @brief  GPIO used by the buzzer: PA9 = TIM1_CH2, PA12 = TIM1_CH2N (AF6).
  64:../Src/music.c ****   */
  65:../Src/music.c **** #define MUSIC_GPIO_PORT               GPIOA
  66:../Src/music.c **** #define MUSIC_GPIO_PIN_CH2            GPIO_PIN_9
  67:../Src/music.c **** #define MUSIC_GPIO_PIN_CH2N           GPIO_PIN_12
  68:../Src/music.c **** #define MUSIC_GPIO_AF                 GPIO_AF6_TIM1
  69:../Src/music.c **** #define MUSIC_GPIO_CLK_ENABLE()       __HAL_RCC_GPIOA_CLK_ENABLE()
  70:../Src/music.c **** 
  71:../Src/music.c **** /**
  72:../Src/music.c ****   * @brief  PWM period in ticks for sample playback.
  73:../Src/music.c ****   *
  74:../Src/music.c ****   *         256 ticks = exact 8 bit duty resolution (one step per sample
  75:../Src/music.c ****   *         quantum). The carrier is then timer_clk/256; at 16 MHz that is
  76:../Src/music.c ****   *         62.5 kHz, far above the audio band, so the carrier is inaudible.
  77:../Src/music.c ****   */
  78:../Src/music.c **** #define MUSIC_PWM_PERIOD              256U
  79:../Src/music.c **** #define MUSIC_DUTY_MAX                (MUSIC_PWM_PERIOD - 1U)
  80:../Src/music.c **** 
  81:../Src/music.c **** /**
  82:../Src/music.c ****   * @brief  Duty span, in percent of the full 8 bit range.
  83:../Src/music.c ****   *
  84:../Src/music.c ****   *         100 % uses the whole PWM range (loudest); the piezo + its direct
  85:../Src/music.c ****   *         drive handle the full swing.
  86:../Src/music.c ****   */
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccneynBe.s 			page 3


  87:../Src/music.c **** #define MUSIC_DUTY_SPAN_PCT           100U
  88:../Src/music.c **** 
  89:../Src/music.c **** /* Private types -------------------------------------------------------------*/
  90:../Src/music.c **** /**
  91:../Src/music.c ****   * @brief  One RBJ biquad (Q15 coefficients) plus its state, for one EQ band.
  92:../Src/music.c ****   */
  93:../Src/music.c **** typedef struct
  94:../Src/music.c **** {
  95:../Src/music.c ****   int32_t b0, b1, b2, a1, a2;          /* Q15 coefficients                   */
  96:../Src/music.c ****   int32_t x1, x2, y1, y2;              /* filter state in Q15                */
  97:../Src/music.c **** } MUSIC_Biquad;
  98:../Src/music.c **** 
