 114:../Src/music.c **** static MUSIC_Biquad s_eq[MUSIC_EQ_BANDS];
 115:../Src/music.c **** static uint8_t      s_eq_enabled = 1U;
 116:../Src/music.c **** 
 117:../Src/music.c **** /**
 118:../Src/music.c ****   * @brief  Volume factor in Q15 (32768 = 100 % = the offline normalised
 119:../Src/music.c ****   *         level). Set from MUSIC_DEFAULT_VOLUME_PCT and changeable at
 120:../Src/music.c ****   *         runtime through MUSIC_SetVolume().
 121:../Src/music.c ****   */
 122:../Src/music.c **** static int32_t s_volume_q15 = (MUSIC_DEFAULT_VOLUME_PCT * 32768) / 100;
 123:../Src/music.c **** 
