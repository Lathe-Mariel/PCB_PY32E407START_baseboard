 228:../Src/music.c **** 
 229:../Src/music.c **** /**
 230:../Src/music.c ****   * @brief  Start (or restart) the playback of the built-in PCM sample.
 231:../Src/music.c ****   *
 232:../Src/music.c ****   *         The buffer holds unsigned 8 bit samples where 128 is silence.
 233:../Src/music.c ****   *         The duty cycle of the PWM follows the (equalised) sample value,
 234:../Src/music.c ****   *         so the piezo driven between PA9 and PA12 reproduces the waveform.
 235:../Src/music.c ****   * @retval None
 236:../Src/music.c ****   */
 237:../Src/music.c **** void MUSIC_Play(void)
 238:../Src/music.c **** {
 239:../Src/music.c ****   uint64_t clk;
 240:../Src/music.c ****   uint64_t ideal;
 241:../Src/music.c ****   uint32_t guess;
 242:../Src/music.c ****   uint32_t best_pre = 1U;
 243:../Src/music.c ****   uint32_t best_arr = 1U;
 244:../Src/music.c ****   uint64_t best_err = UINT64_MAX;
 245:../Src/music.c ****   uint32_t lo, hi, i;
 246:../Src/music.c **** 
 247:../Src/music.c ****   s_pcm        = PLATFORM_PCM_SAMPLES;
 248:../Src/music.c ****   s_pcm_length = PLATFORM_PCM_LENGTH;
 249:../Src/music.c ****   s_pcm_index  = 0U;
 250:../Src/music.c ****   s_playing    = 1U;
 251:../Src/music.c **** 
 252:../Src/music.c ****   /* Carrier: prescaler 0, period 256 ticks (8 bit duty resolution). */
 253:../Src/music.c ****   __HAL_TIM_SET_PRESCALER(&s_pwm, 0U);
 254:../Src/music.c ****   __HAL_TIM_SET_AUTORELOAD(&s_pwm, MUSIC_PWM_PERIOD - 1U);
 255:../Src/music.c ****   HAL_TIM_GenerateEvent(&s_pwm, TIM_EVENTSOURCE_UPDATE);
 256:../Src/music.c ****   __HAL_TIM_CLEAR_FLAG(&s_pwm, TIM_FLAG_UPDATE);
 257:../Src/music.c **** 
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccneynBe.s 			page 6


 258:../Src/music.c ****   /* Pace timer: pick the prescaler/period pair with the smallest rate
 259:../Src/music.c ****      error, like the pmod-audio sample does. */
 260:../Src/music.c ****   clk   = s_note_timer_clk_hz;
 261:../Src/music.c ****   ideal = clk / PLATFORM_PCM_RATE_HZ;
 262:../Src/music.c **** 
 263:../Src/music.c ****   guess = 1U;
 264:../Src/music.c ****   while ((clk / ((uint64_t)guess * PLATFORM_PCM_RATE_HZ)) > 65536ULL)
 265:../Src/music.c ****   {
 266:../Src/music.c ****     guess++;
 267:../Src/music.c ****   }
 268:../Src/music.c **** 
 269:../Src/music.c ****   lo = guess;
 270:../Src/music.c ****   hi = guess + 8U;
 271:../Src/music.c ****   for (i = lo; i <= hi; i++)
 272:../Src/music.c ****   {
 273:../Src/music.c ****     uint64_t ticks = clk / i;
 274:../Src/music.c ****     uint64_t got, diff, err;
 275:../Src/music.c ****     uint32_t arr;
 276:../Src/music.c **** 
 277:../Src/music.c ****     if (ticks == 0ULL)
 278:../Src/music.c ****     {
 279:../Src/music.c ****       continue;
 280:../Src/music.c ****     }
 281:../Src/music.c **** 
 282:../Src/music.c ****     arr = (uint32_t)((ticks + (PLATFORM_PCM_RATE_HZ / 2U)) / PLATFORM_PCM_RATE_HZ);
 283:../Src/music.c ****     if ((arr == 0U) || (arr > 65536U))
 284:../Src/music.c ****     {
 285:../Src/music.c ****       continue;
 286:../Src/music.c ****     }
 287:../Src/music.c **** 
 288:../Src/music.c ****     got  = (uint64_t)i * arr;
 289:../Src/music.c ****     diff = (got > ideal) ? (got - ideal) : (ideal - got);
 290:../Src/music.c ****     err  = (diff * 1000000ULL) / (ideal ? ideal : 1ULL);
 291:../Src/music.c ****     if (err < best_err)
 292:../Src/music.c ****     {
 293:../Src/music.c ****       best_err = err;
 294:../Src/music.c ****       best_pre = i;
 295:../Src/music.c ****       best_arr = arr;
 296:../Src/music.c ****       if (err == 0ULL)
 297:../Src/music.c ****       {
 298:../Src/music.c ****         break;
 299:../Src/music.c ****       }
 300:../Src/music.c ****     }
 301:../Src/music.c ****   }
 302:../Src/music.c **** 
 303:../Src/music.c ****   __HAL_TIM_DISABLE(&s_note);
 304:../Src/music.c ****   __HAL_TIM_SET_PRESCALER(&s_note, best_pre - 1U);
 305:../Src/music.c ****   __HAL_TIM_SET_AUTORELOAD(&s_note, best_arr - 1U);
 306:../Src/music.c ****   __HAL_TIM_SET_COUNTER(&s_note, 0U);
 307:../Src/music.c ****   __HAL_TIM_CLEAR_FLAG(&s_note, TIM_FLAG_UPDATE);
 308:../Src/music.c **** 
 309:../Src/music.c ****   /* Enable both outputs (CC2E + CC2NE), the main output (MOE) and the
 310:../Src/music.c ****      counter (CEN) with direct register writes: the HAL start/stop functions
 311:../Src/music.c ****      manage a channel state machine that cannot run twice in a row without
 312:../Src/music.c ****      an interleaved stop, and this path runs again from the repeat loop. */
 313:../Src/music.c ****   s_pwm.Instance->CCER |= (TIM_CCER_CC2E | TIM_CCER_CC2NE);
 314:../Src/music.c ****   __HAL_TIM_MOE_ENABLE(&s_pwm);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccneynBe.s 			page 7


 315:../Src/music.c ****   __HAL_TIM_ENABLE(&s_pwm);
 316:../Src/music.c **** 
 317:../Src/music.c ****   __HAL_TIM_ENABLE(&s_note);
 318:../Src/music.c ****   __HAL_TIM_ENABLE_IT(&s_note, TIM_IT_UPDATE);
 319:../Src/music.c **** 
 320:../Src/music.c ****   /* Release the first sample right away so playback starts immediately. */
 321:../Src/music.c ****   MUSIC_SetSample(s_pcm[0]);
 322:../Src/music.c ****   s_pcm_index = 1U;
 323:../Src/music.c **** }
 324:../Src/music.c **** 
 325:../Src/music.c **** /**
 326:../Src/music.c ****   * @brief  Stop playback and mute the output.
 327:../Src/music.c ****   * @retval None
 328:../Src/music.c ****   */
 329:../Src/music.c **** void MUSIC_Stop(void)
