 179:../Src/music.c ****   {
 180:../Src/music.c ****     APP_ErrorHandler();
 181:../Src/music.c ****   }
 182:../Src/music.c **** 
 183:../Src/music.c ****   /* No break input, no dead time (a piezo has no shoot-through path). MOE is
 184:../Src/music.c ****      required to release CH2/CH2N at all; OSSR/OSSI keep the outputs
 185:../Src/music.c ****      timer-controlled while muted so the two terminals sit low. */
