 517:../Src/music.c **** /**
 518:../Src/music.c ****   * @brief  Output one PCM sample (optionally through the runtime EQ).
 519:../Src/music.c ****   *
 520:../Src/music.c ****   *         Signal path: EQ -> volume makeup gain -> soft limiter -> duty.
 521:../Src/music.c ****   *         The sample is centred on 128 (silence); the duty map puts the
 522:../Src/music.c ****   *         value onto the full 8 bit span of the 256-count period.
 523:../Src/music.c ****   * @param  value unsigned 8 bit sample, 128 = silence.
 524:../Src/music.c ****   * @retval None
 525:../Src/music.c ****   */
 526:../Src/music.c **** static void MUSIC_SetSample(uint8_t value)
 527:../Src/music.c **** {
 528:../Src/music.c ****   int32_t duty;
 529:../Src/music.c ****   int32_t s;
 530:../Src/music.c **** 
 531:../Src/music.c ****   /* signed sample in -128..+127, scaled to Q15 */
 532:../Src/music.c ****   s = ((int32_t)value - 128) << 8;
 533:../Src/music.c **** 
 534:../Src/music.c ****   if (s_eq_enabled)
 535:../Src/music.c ****   {
 536:../Src/music.c ****     s = MUSIC_EqSample(s);
 537:../Src/music.c ****   }
 538:../Src/music.c **** 
 539:../Src/music.c ****   /* Volume makeup gain (Q15 multiply), then the soft limiter keeps the
 540:../Src/music.c ****      peaks from hard-clipping when the gain pushes them past full scale. */
 541:../Src/music.c ****   s = (int32_t)(((int64_t)s * s_volume_q15) >> 15);
 542:../Src/music.c ****   s = MUSIC_SoftLimit(s);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccneynBe.s 			page 11


 543:../Src/music.c **** 
 544:../Src/music.c ****   /* back to the -128..+127 range with rounding and saturation */
 545:../Src/music.c ****   s = (s + (1 << 7)) >> 8;
 546:../Src/music.c ****   if (s >  127)
 547:../Src/music.c ****   {
 548:../Src/music.c ****     s =  127;
 549:../Src/music.c ****   }
 550:../Src/music.c ****   if (s < -128)
 551:../Src/music.c ****   {
 552:../Src/music.c ****     s = -128;
 553:../Src/music.c ****   }
 554:../Src/music.c **** 
 555:../Src/music.c ****   /* Map the 0..255 sample onto the duty span around 0..MUSIC_DUTY_MAX. */
 556:../Src/music.c ****   duty = ((int32_t)(s + 128) * (int32_t)MUSIC_DUTY_MAX) / 255;
 557:../Src/music.c **** 
 558:../Src/music.c ****   /* CCR2 preload (OC2PE) is on, so the new value latches at the next
 559:../Src/music.c ****      update event - no phase jitter inside the carrier cycles. */
 560:../Src/music.c ****   __HAL_TIM_SET_COMPARE(&s_pwm, TIM_CHANNEL_2, (uint32_t)duty);
 561:../Src/music.c **** }
