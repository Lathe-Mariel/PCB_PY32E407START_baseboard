  35:../Src/main.c **** /* Private define ------------------------------------------------------------*/
  36:../Src/main.c **** /**
  37:../Src/main.c ****   * @brief  Idle time between two playbacks, in milliseconds.
  38:../Src/main.c ****   */
  39:../Src/main.c **** #define APP_SONG_GAP_MS             1500U
  40:../Src/main.c **** 
  41:../Src/main.c **** #define LED_GPIO_PIN                 LED2_PIN
  42:../Src/main.c **** #define LED_GPIO_PORT                LED2_GPIO_PORT
  43:../Src/main.c **** #define LED_GPIO_CLK_ENABLE()        LED2_GPIO_CLK_ENABLE()
  44:../Src/main.c **** 
