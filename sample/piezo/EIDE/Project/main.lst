  55:../Src/main.c **** 
  56:../Src/main.c **** /**
  57:../Src/main.c ****   * @brief  Main program.
  58:../Src/main.c ****   *
  59:../Src/main.c ****   *         The board plays platform.wav (converted to 8 bit PCM at 16 kHz
  60:../Src/main.c ****   *         by tools/wav2pcm.py, offline-equalised and level-compressed for
  61:../Src/main.c ****   *         speech intelligibility) on the passive piezo buzzer connected to
  62:../Src/main.c ****   *         PA9/PA12. The buzzer is driven differentially by the complementary
  63:../Src/main.c ****   *         PWM pair TIM1_CH2 (PA9) / TIM1_CH2N (PA12) as a PWM DAC, and a
  64:../Src/main.c ****   *         runtime 6-band equaliser (same band layout as the offline one)
  65:../Src/main.c ****   *         refines the tone on the target. See music.c / platform_pcm.c.
  66:../Src/main.c ****   * @retval int
  67:../Src/main.c ****   */
  68:../Src/main.c **** int main(void)
  69:../Src/main.c **** {
  70:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick */
  71:../Src/main.c ****   HAL_Init();
  72:../Src/main.c **** 
  73:../Src/main.c ****   /* Configure Systemclock */
  74:../Src/main.c ****   APP_SystemClockConfig();
  75:../Src/main.c **** 
  76:../Src/main.c ****   /* Initialize GPIO */
  77:../Src/main.c ****   APP_GpioConfig();
  78:../Src/main.c **** 
  79:../Src/main.c ****   /* Initialize the buzzer output and start playing */
  80:../Src/main.c ****   MUSIC_Init();
  81:../Src/main.c ****   MUSIC_Play();
  82:../Src/main.c **** 
  83:../Src/main.c ****   /* Infinite loop */
  84:../Src/main.c ****   while (1)
  85:../Src/main.c ****   {
  86:../Src/main.c ****     /* Restart the playback when it is over */
  87:../Src/main.c ****     if (MUSIC_IsPlaying() == 0U)
  88:../Src/main.c ****     {
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccXoHYNv.s 			page 3


  89:../Src/main.c ****       HAL_Delay(APP_SONG_GAP_MS);
  90:../Src/main.c ****       MUSIC_Play();
  91:../Src/main.c ****     }
  92:../Src/main.c **** 
  93:../Src/main.c ****     /* Heartbeat: 2 Hz blink while the melody is playing */
  94:../Src/main.c ****     HAL_Delay(250);
  95:../Src/main.c ****     HAL_GPIO_TogglePin(LED_GPIO_PORT, LED_GPIO_PIN);
  96:../Src/main.c ****   }
  97:../Src/main.c **** }
  98:../Src/main.c **** 
