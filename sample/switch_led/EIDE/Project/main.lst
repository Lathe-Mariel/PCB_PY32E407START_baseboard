  47:../Src/main.c ****   */
  48:../Src/main.c **** int main(void)
  49:../Src/main.c **** {
  50:../Src/main.c ****   uint8_t sw1Pressed;
  51:../Src/main.c ****   uint8_t sw2Pressed;
  52:../Src/main.c ****   uint8_t sw3Pressed;
  53:../Src/main.c ****   uint8_t sw4Pressed;
  54:../Src/main.c **** 
  55:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick. */ 
  56:../Src/main.c ****   HAL_Init();
  57:../Src/main.c ****   
  58:../Src/main.c ****   /* System clock configuration */
  59:../Src/main.c ****   APP_SystemClockConfig(); 
  60:../Src/main.c ****   
  61:../Src/main.c ****   /* Initialize GPIO */
  62:../Src/main.c ****   APP_GpioConfig();
  63:../Src/main.c **** 
  64:../Src/main.c ****   while (1)
  65:../Src/main.c ****   {
  66:../Src/main.c ****     /* Read switches (active low: pressed = GPIO_PIN_RESET) */
  67:../Src/main.c ****     sw1Pressed = (HAL_GPIO_ReadPin(SW_PF3_PORT,  SW_PF3_PIN)  == GPIO_PIN_RESET);
  68:../Src/main.c ****     sw2Pressed = (HAL_GPIO_ReadPin(SW_PC13_PORT, SW_PC13_PIN) == GPIO_PIN_RESET);
  69:../Src/main.c ****     sw3Pressed = (HAL_GPIO_ReadPin(SW_PB7_PORT,  SW_PB7_PIN)  == GPIO_PIN_RESET);
  70:../Src/main.c ****     sw4Pressed = (HAL_GPIO_ReadPin(SW_PB9_PORT,  SW_PB9_PIN)  == GPIO_PIN_RESET);
  71:../Src/main.c **** 
  72:../Src/main.c ****     /* Drive LEDs (active low: lit = GPIO_PIN_RESET) */
  73:../Src/main.c ****     HAL_GPIO_WritePin(LED_PORT, LED_PA3_PIN, sw1Pressed ? GPIO_PIN_RESET : GPIO_PIN_SET);
  74:../Src/main.c ****     HAL_GPIO_WritePin(LED_PORT, LED_PA4_PIN, sw2Pressed ? GPIO_PIN_RESET : GPIO_PIN_SET);
  75:../Src/main.c ****     HAL_GPIO_WritePin(LED_PORT, LED_PA5_PIN, sw3Pressed ? GPIO_PIN_RESET : GPIO_PIN_SET);
  76:../Src/main.c ****     HAL_GPIO_WritePin(LED_PORT, LED_PA6_PIN, sw4Pressed ? GPIO_PIN_RESET : GPIO_PIN_SET);
  77:../Src/main.c ****   }  
  78:../Src/main.c **** }
