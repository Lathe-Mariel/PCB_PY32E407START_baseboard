 305:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** 
 306:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** /**
 307:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @brief Enter Stop 0 mode.
 308:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  In Stop 0 mode, main and low voltage regulators are ON.
 309:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  In Stop 0 mode, all I/O pins keep the same state as in Run mode.
 310:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  All clocks in the VCORE domain are stopped; the PLL, the HSI
 311:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        and the HSE oscillators are disabled. Some peripherals with the wakeup capability
 312:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        (I2Cx, LPUART) can switch on the HSI to receive a frame, and switch off the HSI
 313:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        after receiving the frame if it is not a wakeup frame. In this case, the HSI clock is pr
 314:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        only to the peripheral requesting it.
 315:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        SRAM1, SRAM2 and register contents are preserved.
 316:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        The BOR is available.
 317:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  When exiting Stop 0 mode by issuing an interrupt or a wakeup event,
 318:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *         the HSI RC oscillator is selected as system clock.
 319:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  By keeping the internal regulator ON during Stop 0 mode, the consumption
 320:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *         is higher although the startup time is reduced.
 321:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @param STOPEntry  specifies if Stop mode in entered with WFI or WFE instruction.
 322:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *          This parameter can be one of the following values:
 323:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *            @arg @ref PWR_STOPENTRY_WFI  Enter Stop mode with WFI instruction
 324:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *            @arg @ref PWR_STOPENTRY_WFE  Enter Stop mode with WFE instruction
 325:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @retval None
 326:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   */
 327:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** void HAL_PWREx_EnterSTOP0Mode(uint8_t STOPEntry)
 328:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** {
 522              		.loc 1 328 1 is_stmt 1 view -0
