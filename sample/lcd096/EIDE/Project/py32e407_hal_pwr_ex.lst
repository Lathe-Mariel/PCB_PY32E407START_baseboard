 356:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** /**
 357:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @brief Enter Stop 1 mode.
 358:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  In Stop 1 mode, only low power voltage regulator is ON.
 359:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  In Stop 1 mode, all I/O pins keep the same state as in Run mode.
 360:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  All clocks in the VCORE domain are stopped; the PLL, the HSI
 361:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        and the HSE oscillators are disabled. Some peripherals with the wakeup capability
 362:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        (I2Cx, LPUART) can switch on the HSI to receive a frame, and switch off the HSI
 363:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        after receiving the frame if it is not a wakeup frame. In this case, the HSI clock is pr
 364:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        only to the peripheral requesting it.
 365:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        SRAM1, SRAM2 and register contents are preserved.
 366:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *        The BOR is available.
 367:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  When exiting Stop 1 mode by issuing an interrupt or a wakeup event,
 368:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *         the HSI RC oscillator is selected as system clock.
 369:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @note  Due to low power mode, an additional startup delay is incurred when waking up from Stop 
 370:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @param STOPEntry  specifies if Stop mode in entered with WFI or WFE instruction.
 371:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *          This parameter can be one of the following values:
 372:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *            @arg @ref PWR_STOPENTRY_WFI  Enter Stop mode with WFI instruction
 373:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   *            @arg @ref PWR_STOPENTRY_WFE  Enter Stop mode with WFE instruction
 374:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   * @retval None
 375:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c ****   */
 376:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr_ex.c **** void HAL_PWREx_EnterSTOP1Mode(uint8_t STOPEntry)
