  32:../Src/main.c **** #include "main.h"
  33:../Src/main.c **** #include "lcd096.h"
  34:../Src/main.c **** 
  35:../Src/main.c **** /* Private define ------------------------------------------------------------*/
  36:../Src/main.c **** #define LED_GPIO_PIN                 LED2_PIN
  37:../Src/main.c **** #define LED_GPIO_PORT                LED2_GPIO_PORT
  38:../Src/main.c **** #define LED_GPIO_CLK_ENABLE()        LED2_GPIO_CLK_ENABLE()
  39:../Src/main.c **** 
  40:../Src/main.c **** /* --------------------------------------------------------------------------
  41:../Src/main.c ****    On-board debug LEDs (4x, ACTIVE LOW: pin driven LOW => LED lit).
  42:../Src/main.c ****    They display the bring-up STAGE NUMBER in binary so a black screen can be
  43:../Src/main.c ****    localised without a scope (bit0 = LED1/PA3, bit1 = LED2/PA4,
  44:../Src/main.c ****    bit2 = LED3/PA5, bit3 = LED4/PA6). Read the pattern left-to-right as
  45:../Src/main.c ****    LED4 LED3 LED2 LED1 = bit3 bit2 bit1 bit0.
  46:../Src/main.c **** 
  47:../Src/main.c ****    Stage codes emitted by this file and by lcd096.c via LCD096_DebugHook():
  48:../Src/main.c ****      1  clock + debug-LED init done
  49:../Src/main.c ****      2  APP_GpioConfig() done
  50:../Src/main.c ****      3  LCD GPIO config done          (start of LCD096_Init)
  51:../Src/main.c ****      4  hardware reset pulse done
  52:../Src/main.c ****      5  SWRESET (0x01) sent
  53:../Src/main.c ****      6  SLPOUT  (0x11) sent
  54:../Src/main.c ****      7  COLMOD+MADCTL sent
  55:../Src/main.c ****      8  FRMCTR/power/VCOM sent
  56:../Src/main.c ****      9  gamma sent
  57:../Src/main.c ****     10  DISPON (0x29) sent
  58:../Src/main.c ****     11  frame-memory fill finished
  59:../Src/main.c ****     81  pin self-test: CS  driven HIGH
  60:../Src/main.c ****     82  pin self-test: SDA (MOSI) driven HIGH
  61:../Src/main.c ****     83  pin self-test: DC  driven HIGH
  62:../Src/main.c ****     84  pin self-test: SCK driven HIGH
  63:../Src/main.c ****     85  pin self-test: RST driven HIGH
  64:../Src/main.c ****    After stage 11 the LEDs are re-driven each loop iteration, so a frozen
  65:../Src/main.c ****    pattern means the firmware stopped at that stage (or is looping there).
  66:../Src/main.c ****    -------------------------------------------------------------------------- */
  67:../Src/main.c **** #define DBG_LED_PORT                 GPIOA
  68:../Src/main.c **** #define DBG_LED1_PIN                 GPIO_PIN_3
  69:../Src/main.c **** #define DBG_LED2_PIN                 GPIO_PIN_4
  70:../Src/main.c **** #define DBG_LED3_PIN                 GPIO_PIN_5
  71:../Src/main.c **** #define DBG_LED4_PIN                 GPIO_PIN_6
  72:../Src/main.c **** #define DBG_LED_ALL_PINS             (DBG_LED1_PIN | DBG_LED2_PIN | \
  73:../Src/main.c ****                                       DBG_LED3_PIN | DBG_LED4_PIN)
  74:../Src/main.c **** 
  75:../Src/main.c **** /* Private variables ---------------------------------------------------------*/
  76:../Src/main.c **** static volatile uint8_t g_dbg_stage = 0U;
  77:../Src/main.c **** 
  78:../Src/main.c **** /* Private user code ---------------------------------------------------------*/
  79:../Src/main.c **** /* Private macro -------------------------------------------------------------*/
  80:../Src/main.c **** /* Private function prototypes -----------------------------------------------*/
  81:../Src/main.c **** static void APP_SystemClockConfig(void);
  82:../Src/main.c **** static void APP_GpioConfig(void);
  83:../Src/main.c **** static void APP_DebugLedInit(void);
  84:../Src/main.c **** static void APP_DebugLedShow(uint8_t code);
  85:../Src/main.c **** 
  86:../Src/main.c **** /**
  87:../Src/main.c ****   * @brief  Debug hook called from lcd096.c at each bring-up step.
  88:../Src/main.c ****   * @param  stage stage code (see the table above).
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cc2nLoGR.s 			page 3


  89:../Src/main.c ****   * @retval None
  90:../Src/main.c ****   */
  91:../Src/main.c **** void LCD096_DebugHook(uint8_t stage);
  92:../Src/main.c **** 
  93:../Src/main.c **** /* Set to 1 to run the pin self-test instead of the normal boot. In that mode
  94:../Src/main.c ****    each LCD pin is driven HIGH on its own for a second, so a meter or a bare LED
  95:../Src/main.c ****    can confirm which MCU pin it is really connected to. */
  96:../Src/main.c **** #define APP_RUN_PIN_SELFTEST         0
  97:../Src/main.c **** 
  98:../Src/main.c **** /**
  99:../Src/main.c ****   * @brief  Main program.
 100:../Src/main.c ****   *
 101:../Src/main.c ****   *         Brings up the Pmod-LCD-0.96 panel (ST7735S, 160x80) over software
 102:../Src/main.c ****   *         SPI and paints it orange. The four on-board LEDs show the bring-up
 103:../Src/main.c ****   *         stage in binary so a failure can be localised.
 104:../Src/main.c ****   *
 105:../Src/main.c ****   *         A Pmod can be inserted either way round, so BOTH electrically valid
 106:../Src/main.c ****   *         pin maps are driven in turn (see LCD096_PMOD_ROW in lcd096.h).
 107:../Src/main.c ****   *         The insertion that is actually fitted paints the panel orange and
 108:../Src/main.c ****   *         holds it there; the other one does nothing and is overwritten.
 109:../Src/main.c ****   * @retval int
 110:../Src/main.c ****   */
 111:../Src/main.c **** int main(void)
 112:../Src/main.c **** {
 113:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick. */ 
 114:../Src/main.c ****   HAL_Init();
 115:../Src/main.c ****   
 116:../Src/main.c ****   /* System clock configuration */
 117:../Src/main.c ****   APP_SystemClockConfig(); 
 118:../Src/main.c **** 
 119:../Src/main.c ****   /* Debug LEDs first so stage 1 proves the clock + GPIO bring-up. */
 120:../Src/main.c ****   APP_DebugLedInit();
 121:../Src/main.c ****   LCD096_DebugHook(1U);
 122:../Src/main.c **** 
 123:../Src/main.c ****   /* Initialize GPIO */
 124:../Src/main.c ****   APP_GpioConfig();
 125:../Src/main.c ****   LCD096_DebugHook(2U);
 126:../Src/main.c **** 
 127:../Src/main.c **** #if (APP_RUN_PIN_SELFTEST)
 128:../Src/main.c ****   LCD096_PinSelfTest(1000U);
 129:../Src/main.c **** #endif
 130:../Src/main.c **** 
 131:../Src/main.c ****   /* Pmod row 1 (CS=PD7, MOSI=PB6, DC=PC8, CLK=PC9, RST=PD4). */
 132:../Src/main.c ****   APP_DebugLedShow(0x0FU);               /* all four lit while row 1 runs */
 133:../Src/main.c ****   LCD096_SetPmodRow(1U);
 134:../Src/main.c ****   LCD096_Init();
 135:../Src/main.c ****   LCD096_FillScreen(LCD096_ORANGE);
 136:../Src/main.c ****   HAL_Delay(2000);                       /* hold so the result is visible */
 137:../Src/main.c **** 
 138:../Src/main.c ****   /* Pmod row 2 (CS=PD3, MOSI=PD5, DC=PD6, CLK=PD4, RST=PC9). If the module is
 139:../Src/main.c ****      inserted this way round, this is the pass that paints it. */
 140:../Src/main.c ****   APP_DebugLedShow(0x00U);
 141:../Src/main.c ****   LCD096_SetPmodRow(2U);
 142:../Src/main.c ****   LCD096_Init();
 143:../Src/main.c ****   LCD096_FillScreen(LCD096_ORANGE);
 144:../Src/main.c ****   HAL_Delay(2000);
 145:../Src/main.c **** 
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cc2nLoGR.s 			page 4


 146:../Src/main.c ****   /* Row 1 again, and stay there: row 1 is the insertion the base board
 147:../Src/main.c ****      silkscreen labels describe, so it is the default end state. */
 148:../Src/main.c ****   LCD096_SetPmodRow(1U);
 149:../Src/main.c ****   LCD096_Init();
 150:../Src/main.c ****   LCD096_FillScreen(LCD096_ORANGE);
 151:../Src/main.c **** 
 152:../Src/main.c ****   while (1)
 153:../Src/main.c ****   {
 154:../Src/main.c ****     /* Pulse the last stage code on/off. Pulsing proves the main loop is
 155:../Src/main.c ****        running (i.e. LCD096_FillScreen() returned); a steady pattern means the
 156:../Src/main.c ****        code is stuck at that stage. */
 157:../Src/main.c ****     APP_DebugLedShow(g_dbg_stage);
 158:../Src/main.c ****     HAL_Delay(500);
 159:../Src/main.c ****     APP_DebugLedShow(0U);
 160:../Src/main.c ****     HAL_Delay(200);
 161:../Src/main.c ****   }  
 162:../Src/main.c **** }
 163:../Src/main.c **** 
 164:../Src/main.c **** /**
 165:../Src/main.c ****   * @brief  Configure the four on-board debug LEDs as push-pull outputs.
 166:../Src/main.c ****   * @param  None
 167:../Src/main.c ****   * @retval None
 168:../Src/main.c ****   */
 169:../Src/main.c **** static void APP_DebugLedInit(void)
 170:../Src/main.c **** {
 171:../Src/main.c ****   GPIO_InitTypeDef  GPIO_InitStruct = {0};
 172:../Src/main.c **** 
 173:../Src/main.c ****   __HAL_RCC_GPIOA_CLK_ENABLE();
 174:../Src/main.c **** 
 175:../Src/main.c ****   GPIO_InitStruct.Pin = DBG_LED_ALL_PINS;
 176:../Src/main.c ****   GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;            /* Push-pull output */
 177:../Src/main.c ****   GPIO_InitStruct.Pull = GPIO_NOPULL;
 178:../Src/main.c ****   GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
 179:../Src/main.c ****   HAL_GPIO_Init(DBG_LED_PORT, &GPIO_InitStruct);
 180:../Src/main.c **** 
 181:../Src/main.c ****   /* Active Low: drive all HIGH to keep the LEDs dark at startup. */
 182:../Src/main.c ****   HAL_GPIO_WritePin(DBG_LED_PORT, DBG_LED_ALL_PINS, GPIO_PIN_SET);
 183:../Src/main.c **** }
 184:../Src/main.c **** 
 185:../Src/main.c **** /**
 186:../Src/main.c ****   * @brief  Show a 4-bit code on the debug LEDs (active low => bit set = lit).
 187:../Src/main.c ****   * @param  code 0..15, bit0 -> LED1 (PA3) ... bit3 -> LED4 (PA6).
 188:../Src/main.c ****   * @retval None
 189:../Src/main.c ****   */
 190:../Src/main.c **** static void APP_DebugLedShow(uint8_t code)
 191:../Src/main.c **** {
 192:../Src/main.c ****   HAL_GPIO_WritePin(DBG_LED_PORT, DBG_LED1_PIN,
 193:../Src/main.c ****                     ((code & 0x01U) != 0U) ? GPIO_PIN_RESET : GPIO_PIN_SET);
 194:../Src/main.c ****   HAL_GPIO_WritePin(DBG_LED_PORT, DBG_LED2_PIN,
 195:../Src/main.c ****                     ((code & 0x02U) != 0U) ? GPIO_PIN_RESET : GPIO_PIN_SET);
 196:../Src/main.c ****   HAL_GPIO_WritePin(DBG_LED_PORT, DBG_LED3_PIN,
 197:../Src/main.c ****                     ((code & 0x04U) != 0U) ? GPIO_PIN_RESET : GPIO_PIN_SET);
 198:../Src/main.c ****   HAL_GPIO_WritePin(DBG_LED_PORT, DBG_LED4_PIN,
 199:../Src/main.c ****                     ((code & 0x08U) != 0U) ? GPIO_PIN_RESET : GPIO_PIN_SET);
 200:../Src/main.c **** }
 201:../Src/main.c **** 
 202:../Src/main.c **** /**
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\cc2nLoGR.s 			page 5


 203:../Src/main.c ****   * @brief  Debug hook called from lcd096.c: latch the stage and show it.
 204:../Src/main.c ****   * @param  stage stage code (see the table above).
 205:../Src/main.c ****   * @retval None
 206:../Src/main.c ****   */
 207:../Src/main.c **** void LCD096_DebugHook(uint8_t stage)
 208:../Src/main.c **** {
 209:../Src/main.c ****   g_dbg_stage = stage;
 210:../Src/main.c ****   APP_DebugLedShow(stage);
 211:../Src/main.c **** }
 212:../Src/main.c **** 
