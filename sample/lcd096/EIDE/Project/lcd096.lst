   1:../Src/lcd096.c **** /**
   2:../Src/lcd096.c ****   ******************************************************************************
   3:../Src/lcd096.c ****   * @file    lcd096.c
   4:../Src/lcd096.c ****   * @brief   Software (bit-bang) SPI driver for the Pmod-LCD-0.96 v1.0 module.
   5:../Src/lcd096.c ****   *
   6:../Src/lcd096.c ****   *          LCD controller : ST7735S
   7:../Src/lcd096.c ****   *          Resolution     : 160 x 80 (RGB565, 4-wire serial)
   8:../Src/lcd096.c ****   *          SPI mode       : CPOL = 0, CPHA = 0 (data latched on SCK rising)
   9:../Src/lcd096.c ****   *
  10:../Src/lcd096.c ****   *          The PY32E407 drives the panel with a plain GPIO bit-bang because
  11:../Src/lcd096.c ****   *          the 4-wire serial interface needs CS/DC/RST in addition to the two
  12:../Src/lcd096.c ****   *          SPI wires, and the module is tolerant of a slow clock. Keeping the
  13:../Src/lcd096.c ****   *          SPI in software also means no hardware SPI peripheral / DMA is
  14:../Src/lcd096.c ****   *          required and the sample matches the existing lcd sample style.
  15:../Src/lcd096.c ****   *
  16:../Src/lcd096.c ****   *          Wiring: see lcd096.h. The module plugs into the base board Pmod
  17:../Src/lcd096.c ****   *          socket J3 and can be inserted either way round, so the pin map is
  18:../Src/lcd096.c ****   *          selected at runtime (LCD096_SetPmodRow / LCD096_PMOD_ROW).
  19:../Src/lcd096.c ****   *            row 1 : CS=PD7, MOSI=PB6, DC=PC8, CLK=PC9, RST=PD4
  20:../Src/lcd096.c ****   *            row 2 : CS=PD3, MOSI=PD5, DC=PD6, CLK=PD4, RST=PC9
  21:../Src/lcd096.c ****   ******************************************************************************
  22:../Src/lcd096.c ****   */
  23:../Src/lcd096.c **** 
  24:../Src/lcd096.c **** /* Includes ------------------------------------------------------------------*/
  25:../Src/lcd096.c **** #include "lcd096.h"
  26:../Src/lcd096.c **** 
  27:../Src/lcd096.c **** /* Private types -------------------------------------------------------------*/
  28:../Src/lcd096.c **** 
  29:../Src/lcd096.c **** /* One Pmod insertion worth of pins. */
  30:../Src/lcd096.c **** typedef struct
  31:../Src/lcd096.c **** {
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccUBi52b.s 			page 2


  32:../Src/lcd096.c ****   GPIO_TypeDef *cs_port;  uint16_t cs_pin;
  33:../Src/lcd096.c ****   GPIO_TypeDef *sda_port; uint16_t sda_pin;
  34:../Src/lcd096.c ****   GPIO_TypeDef *dc_port;  uint16_t dc_pin;
  35:../Src/lcd096.c ****   GPIO_TypeDef *sck_port; uint16_t sck_pin;
  36:../Src/lcd096.c ****   GPIO_TypeDef *rst_port; uint16_t rst_pin;
  37:../Src/lcd096.c **** } LCD096_Pins_t;
  38:../Src/lcd096.c **** 
  39:../Src/lcd096.c **** /* Private variables ---------------------------------------------------------*/
  40:../Src/lcd096.c **** static const LCD096_Pins_t LCD096_ROW1 =
  41:../Src/lcd096.c **** {
  42:../Src/lcd096.c ****   LCD096_R1_CS_PORT,  LCD096_R1_CS_PIN,
  43:../Src/lcd096.c ****   LCD096_R1_SDA_PORT, LCD096_R1_SDA_PIN,
  44:../Src/lcd096.c ****   LCD096_R1_DC_PORT,  LCD096_R1_DC_PIN,
  45:../Src/lcd096.c ****   LCD096_R1_SCK_PORT, LCD096_R1_SCK_PIN,
  46:../Src/lcd096.c ****   LCD096_R1_RST_PORT, LCD096_R1_RST_PIN
  47:../Src/lcd096.c **** };
  48:../Src/lcd096.c **** 
  49:../Src/lcd096.c **** static const LCD096_Pins_t LCD096_ROW2 =
  50:../Src/lcd096.c **** {
  51:../Src/lcd096.c ****   LCD096_R2_CS_PORT,  LCD096_R2_CS_PIN,
  52:../Src/lcd096.c ****   LCD096_R2_SDA_PORT, LCD096_R2_SDA_PIN,
  53:../Src/lcd096.c ****   LCD096_R2_DC_PORT,  LCD096_R2_DC_PIN,
  54:../Src/lcd096.c ****   LCD096_R2_SCK_PORT, LCD096_R2_SCK_PIN,
  55:../Src/lcd096.c ****   LCD096_R2_RST_PORT, LCD096_R2_RST_PIN
  56:../Src/lcd096.c **** };
  57:../Src/lcd096.c **** 
  58:../Src/lcd096.c **** #if (LCD096_PMOD_ROW == 2U)
  59:../Src/lcd096.c **** static const LCD096_Pins_t *s_pins = &LCD096_ROW2;
  60:../Src/lcd096.c **** #else
  61:../Src/lcd096.c **** static const LCD096_Pins_t *s_pins = &LCD096_ROW1;
  62:../Src/lcd096.c **** #endif
  63:../Src/lcd096.c **** 
  64:../Src/lcd096.c **** /* Private define ------------------------------------------------------------*/
  65:../Src/lcd096.c **** 
  66:../Src/lcd096.c **** /* Bit-bang half period, in loops of the SCK half cycle. 0 = as fast as the
  67:../Src/lcd096.c ****    CPU allows (the ST7735S is happy well above 10 MHz, but the loop overhead at
  68:../Src/lcd096.c ****    16 MHz HSI keeps SCK down to a few MHz, which is a safe place to be). */
  69:../Src/lcd096.c **** #define LCD096_BIT_DELAY_LOOPS      (0U)
  70:../Src/lcd096.c **** 
  71:../Src/lcd096.c **** /* SCK is reset to its idle level at the start of EVERY byte. A free-running
  72:../Src/lcd096.c ****    bit-bang can otherwise begin a byte on an arbitrary half cycle: if it starts
  73:../Src/lcd096.c ****    while SCK is still HIGH the first action is a falling edge, and the panel
  74:../Src/lcd096.c ****    then shifts in one spurious bit (every following byte is off by one). */
  75:../Src/lcd096.c **** #define LCD096_SCK_LOW()            HAL_GPIO_WritePin(s_pins->sck_port, s_pins->sck_pin, GPIO_PIN_R
  76:../Src/lcd096.c **** #define LCD096_SCK_HIGH()           HAL_GPIO_WritePin(s_pins->sck_port, s_pins->sck_pin, GPIO_PIN_S
  77:../Src/lcd096.c **** 
  78:../Src/lcd096.c **** /* CS is held LOW for the whole command/data sequence, as required by the
  79:../Src/lcd096.c ****    ST7735S 4-wire serial interface (raising CS in the middle of a command
  80:../Src/lcd096.c ****    aborts it and the parameters are ignored). */
  81:../Src/lcd096.c **** #define LCD096_CS_LOW()             HAL_GPIO_WritePin(s_pins->cs_port,  s_pins->cs_pin,  GPIO_PIN_R
  82:../Src/lcd096.c **** #define LCD096_CS_HIGH()            HAL_GPIO_WritePin(s_pins->cs_port,  s_pins->cs_pin,  GPIO_PIN_S
  83:../Src/lcd096.c **** #define LCD096_DC_CMD()             HAL_GPIO_WritePin(s_pins->dc_port,  s_pins->dc_pin,  GPIO_PIN_R
  84:../Src/lcd096.c **** #define LCD096_DC_DATA()            HAL_GPIO_WritePin(s_pins->dc_port,  s_pins->dc_pin,  GPIO_PIN_S
  85:../Src/lcd096.c **** #define LCD096_RST_LOW()            HAL_GPIO_WritePin(s_pins->rst_port, s_pins->rst_pin, GPIO_PIN_R
  86:../Src/lcd096.c **** #define LCD096_RST_HIGH()           HAL_GPIO_WritePin(s_pins->rst_port, s_pins->rst_pin, GPIO_PIN_S
  87:../Src/lcd096.c **** #define LCD096_SDA_LOW()            HAL_GPIO_WritePin(s_pins->sda_port, s_pins->sda_pin, GPIO_PIN_R
  88:../Src/lcd096.c **** #define LCD096_SDA_HIGH()           HAL_GPIO_WritePin(s_pins->sda_port, s_pins->sda_pin, GPIO_PIN_S
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccUBi52b.s 			page 3


