 359:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c **** /**
 360:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   * @brief  Gets the priority of an interrupt.
 361:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   * @param  IRQn: External interrupt number.
 362:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *         This parameter can be an enumerator of IRQn_Type enumeration
 363:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *         (For the complete PY32 Devices IRQ Channels list, please refer to the appropriate CMSIS
 364:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   * @param   PriorityGroup: the priority grouping bits length.
 365:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *         This parameter can be one of the following values:
 366:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *           @arg NVIC_PRIORITYGROUP_0: 0 bits for preemption priority
 367:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *                                      3 bits for subpriority
 368:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *           @arg NVIC_PRIORITYGROUP_1: 1 bits for preemption priority
 369:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *                                      2 bits for subpriority
 370:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *           @arg NVIC_PRIORITYGROUP_2: 2 bits for preemption priority
 371:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *                                      1 bits for subpriority
 372:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_cortex.c ****   *           @arg NVIC_PRIORITYGROUP_3: 3 bits for preemption priority
