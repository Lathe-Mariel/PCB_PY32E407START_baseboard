 101:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** 
 102:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** /** @defgroup HAL_Exported_Functions_Group1 Initialization and de-initialization Functions
 103:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****  *  @brief    Initialization and de-initialization functions
 104:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****  *
 105:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** @verbatim
 106:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****  ===============================================================================
 107:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****               ##### Initialization and de-initialization functions #####
 108:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****  ===============================================================================
 109:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****    [..]  This section provides functions allowing to:
 110:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****       (+) Initializes the Flash interface, the NVIC allocation and initial clock
 111:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****           configuration. It initializes the systick also when timeout is needed
 112:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****           and the backup domain when enabled.
 113:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****       (+) de-Initializes common part of the HAL.
 114:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****       (+) Configure The time base source to have 1ms time base with a dedicated
 115:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****           Tick interrupt priority.
 116:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****         (++) SysTick timer is used by default as source of time base, but user
 117:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              can eventually implement his proper time base source (a general purpose
 118:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              timer for example or other time source), keeping in mind that Time base
 119:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              duration should be kept 1ms since PPP_TIMEOUT_VALUEs are defined and
 120:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              handled in milliseconds basis.
 121:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****         (++) Time base configuration function (HAL_InitTick ()) is called automatically
 122:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              at the beginning of the program after reset by HAL_Init() or at any time
 123:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              when clock is configured, by HAL_RCC_ClockConfig().
 124:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****         (++) Source of time base is configured  to generate interrupts at regular
 125:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              time intervals. Care must be taken if HAL_Delay() is called from a
 126:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              peripheral ISR process, the Tick interrupt line must have higher priority
 127:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****             (numerically lower) than the peripheral interrupt. Otherwise the caller
 128:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****             ISR process will be blocked.
 129:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****        (++) functions affecting time base configurations are declared as __weak
 130:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****              to make  override possible  in case of other  implementations in user file.
 131:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** @endverbatim
 132:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   * @{
 133:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   */
 134:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** 
 135:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** /**
 136:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   * @brief  This function is used to initialize the HAL Library; it must be the first
 137:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *         instruction to be executed in the main program (before to call any other
 138:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *         HAL function), it performs the following:
 139:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           Configure the Flash prefetch.
 140:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           Configures the SysTick to generate an interrupt each 1 millisecond,
 141:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           which is clocked by the HSI (at this stage, the clock is not yet
 142:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           configured and thus the system is running from the internal HSI at 16 MHz).
 143:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           Set NVIC Group Priority to 3.
 144:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           Calls the HAL_MspInit() callback function defined in user file
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccC2s8Vl.s 			page 4


 145:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *           "py32e407_hal_msp.c" to do the global low level hardware initialization
 146:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *
 147:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   * @note   SysTick is used as time base for the HAL_Delay() function, the application
 148:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *         need to ensure that the SysTick time base is always set to 1 millisecond
 149:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   *         to have correct HAL operation.
 150:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   * @retval HAL status
 151:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   */
 152:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** HAL_StatusTypeDef HAL_Init(void)
 153:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** {
 154:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   HAL_StatusTypeDef  status = HAL_OK;
 155:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   /* Set Interrupt Group Priority */
 156:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   HAL_NVIC_SetPriorityGrouping(NVIC_PRIORITYGROUP_3);
 157:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   
 158:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   /* Use SysTick as time base source and configure 1ms tick (default clock after Reset is HSI) */
 159:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   if (HAL_InitTick(TICK_INT_PRIORITY) != HAL_OK)
 160:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   {
 161:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****     status = HAL_ERROR;
 162:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   }
 163:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   else
 164:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   {
 165:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****     /* Init the low level hardware */
 166:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****     HAL_MspInit();
 167:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   }
 168:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** 
 169:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   /* Return function status */
 170:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   return status;
 171:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** }
 172:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** 
 173:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** /**
 174:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   * @brief This function de-Initializes common part of the HAL and stops the systick.
