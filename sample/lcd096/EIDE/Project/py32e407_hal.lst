 179:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** HAL_StatusTypeDef HAL_DeInit(void)
 180:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c **** {
 181:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   /* Reset of all peripherals */
 182:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   __HAL_RCC_APB1_1_FORCE_RESET();
 183:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal.c ****   __HAL_RCC_APB1_1_RELEASE_RESET();
