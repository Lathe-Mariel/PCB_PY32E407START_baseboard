1052:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     case RCC_SYSCLKSOURCE_STATUS_PLLCLK:  /* PLL used as system clock */
1053:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     {
1054:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       pllprediv = aDivFactorTable[(uint32_t)(RCC->CFGR3 & RCC_CFGR3_PLLPREDIV) >> RCC_CFGR3_PLLPRED
