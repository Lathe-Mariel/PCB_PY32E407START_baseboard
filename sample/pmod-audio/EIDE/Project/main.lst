  32:../Src/main.c **** #include "main.h"
  33:../Src/main.c **** #include "audio.h"
  34:../Src/main.c **** #include "melody_wav.h"
  35:../Src/main.c **** 
  36:../Src/main.c **** /* Private define ------------------------------------------------------------*/
  37:../Src/main.c **** #define LED_GPIO_PIN                 LED2_PIN
  38:../Src/main.c **** #define LED_GPIO_PORT                LED2_GPIO_PORT
  39:../Src/main.c **** #define LED_GPIO_CLK_ENABLE()        LED2_GPIO_CLK_ENABLE()
  40:../Src/main.c **** 
  41:../Src/main.c **** /**
  42:../Src/main.c ****   * @brief  Idle time between two playbacks of the melody, in milliseconds.
  43:../Src/main.c ****   *
  44:../Src/main.c ****   *         The player mutes the output when the sample is over, so a short gap
  45:../Src/main.c ****   *         makes the repeat audible.
  46:../Src/main.c ****   */
  47:../Src/main.c **** #define APP_SONG_GAP_MS             1500U
  48:../Src/main.c **** 
  49:../Src/main.c **** /* Private variables ---------------------------------------------------------*/
  50:../Src/main.c **** /* Private user code ---------------------------------------------------------*/
  51:../Src/main.c **** /* Private macro -------------------------------------------------------------*/
  52:../Src/main.c **** /* Private function prototypes -----------------------------------------------*/
  53:../Src/main.c **** static void APP_SystemClockConfig(void);
  54:../Src/main.c **** static void APP_GpioConfig(void);
  55:../Src/main.c **** 
  56:../Src/main.c **** /**
  57:../Src/main.c ****   * @brief  Main program.
  58:../Src/main.c ****   *
  59:../Src/main.c ****   *         The board plays Melody.wav on the speaker connected to PA1. PA1 is
  60:../Src/main.c ****   *         driven by TIM2_CH2 in PWM mode: the duty cycle of a 62.5 kHz carrier
  61:../Src/main.c ****   *         follows the PCM sample, so a simple RC low pass filter recovers the
  62:../Src/main.c ****   *         original waveform (the classic class D without feedback PWM DAC).
  63:../Src/main.c ****   *
  64:../Src/main.c ****   *         Melody.wav is converted to unsigned 8 bit PCM at 16 kHz by default,
  65:../Src/main.c ****   *         or 8 kHz with AUDIO_MELODY_SMALL; see melody_wav.c and
  66:../Src/main.c ****   *         melody_wav_s.c. The on-board LED keeps blinking while it plays.
  67:../Src/main.c ****   *
  68:../Src/main.c ****   *         A small RC low pass filter between PA1 and the speaker removes the
  69:../Src/main.c ****   *         carrier and leaves the audio. A single pole (for instance 470 ohm +
  70:../Src/main.c ****   *         10 nF, cut-off around 34 kHz) is enough to hear the tune; a two pole
  71:../Src/main.c ****   *         version (for instance 1 kohm + 10 nF per stage, around 16 kHz) sounds
  72:../Src/main.c ****   *         noticeably cleaner.
  73:../Src/main.c ****   * @retval int
  74:../Src/main.c ****   */
  75:../Src/main.c **** int main(void)
  76:../Src/main.c **** {
  77:../Src/main.c ****   /* Reset of all peripherals, Initializes the Systick. */ 
  78:../Src/main.c ****   HAL_Init();
  79:../Src/main.c ****   
  80:../Src/main.c ****   /* System clock configuration */
  81:../Src/main.c ****   APP_SystemClockConfig(); 
  82:../Src/main.c ****   
  83:../Src/main.c ****   /* Initialize GPIO */
  84:../Src/main.c ****   APP_GpioConfig();
  85:../Src/main.c **** 
  86:../Src/main.c ****   /* Initialize the PWM audio output and start playing Melody.wav */
  87:../Src/main.c ****   AUDIO_Init();
  88:../Src/main.c ****   AUDIO_PlaySample(MELODY_WAV_SAMPLES, MELODY_WAV_LENGTH, MELODY_WAV_RATE_HZ);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccPdxSLE.s 			page 3


  89:../Src/main.c **** 
  90:../Src/main.c ****   while (1)
  91:../Src/main.c ****   {
  92:../Src/main.c ****     /* Restart the melody when it is over */
  93:../Src/main.c ****     if (AUDIO_IsPlayingSample() == 0U)
  94:../Src/main.c ****     {
  95:../Src/main.c ****       HAL_Delay(APP_SONG_GAP_MS);
  96:../Src/main.c ****       AUDIO_PlaySample(MELODY_WAV_SAMPLES, MELODY_WAV_LENGTH, MELODY_WAV_RATE_HZ);
  97:../Src/main.c ****     }
  98:../Src/main.c **** 
  99:../Src/main.c ****     /* Heartbeat: 2 Hz blink while the melody is playing */
 100:../Src/main.c ****     HAL_Delay(250);
 101:../Src/main.c ****     HAL_GPIO_TogglePin(LED_GPIO_PORT, LED_GPIO_PIN);
 102:../Src/main.c ****   }  
 103:../Src/main.c **** }
