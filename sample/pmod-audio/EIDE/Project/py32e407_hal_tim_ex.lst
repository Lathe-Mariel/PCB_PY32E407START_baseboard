 226:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Select the TIM_TS_TI1F_ED signal as Input trigger for the TIM */
 227:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->SMCR &= ~TIM_SMCR_TS;
 228:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->SMCR |= TIM_TS_TI1F_ED;
 229:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
 230:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Use the TIM_TS_TI1F_ED signal to reset the TIM counter each edge detection */
 231:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->SMCR &= ~TIM_SMCR_SMS;
 232:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->SMCR |= TIM_SLAVEMODE_RESET;
 233:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
 234:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Program channel 2 in PWM 2 mode with the desired Commutation_Delay*/
