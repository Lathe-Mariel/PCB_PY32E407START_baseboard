 218:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Reset the IC1PSC Bits */
 219:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->CCMR1 &= ~TIM_CCMR1_IC1PSC;
 220:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Set the IC1PSC value */
