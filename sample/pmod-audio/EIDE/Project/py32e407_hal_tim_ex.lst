 159:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** /**
 160:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @brief  Initializes the TIM Hall Sensor Interface and initialize the associated handle.
 161:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @note   When the timer instance is initialized in Hall Sensor Interface mode,
 162:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *         timer channels 1 and channel 2 are reserved and cannot be used for
 163:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *         other purpose.
 164:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @param  htim TIM Hall Sensor Interface handle
 165:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @param  sConfig TIM Hall Sensor configuration structure
 166:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @retval HAL status
 167:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   */
 168:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** HAL_StatusTypeDef HAL_TIMEx_HallSensor_Init(TIM_HandleTypeDef *htim, const TIM_HallSensor_InitTypeD
 169:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** {
 170:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   TIM_OC_InitTypeDef OC_Config;
