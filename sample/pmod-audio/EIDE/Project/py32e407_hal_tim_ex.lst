 222:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
 223:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Enable the Hall sensor interface (XOR function of the three inputs) */
 224:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   htim->Instance->CR2 |= TIM_CR2_TI1S;
