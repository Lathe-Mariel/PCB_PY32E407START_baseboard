2961:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Get the TIMx ECR register value */
2962:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   tmpecr = htim->Instance->ECR;
2963:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Reset the Pulse width prescaler and the Pulse width */
2964:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   tmpecr &= ~(TIM_ECR_PWPRSC | TIM_ECR_PW);
2965:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   /* Set the Pulse width prescaler and Pulse width*/
2966:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   tmpecr |= PulseWidthPrescaler << TIM_ECR_PWPRSC_Pos;
