   1:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** /**
   2:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ******************************************************************************
   3:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @file    py32e407_hal_tim_ex.c
   4:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @author  MCU Application Team
   5:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   * @brief   TIM HAL module driver.
   6:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *          This file provides firmware functions to manage the following
   7:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *          functionalities of the Timer Extended peripheral:
   8:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time Hall Sensor Interface Initialization
   9:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time Hall Sensor Interface Start
  10:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time Complementary signal break and dead time configuration
  11:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time Master and Slave synchronization configuration
  12:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time Output Compare/PWM Channel Configuration (for channels 5 and 6)
  13:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Time OCRef clear configuration
  14:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Timer remapping capabilities configuration
  15:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   *           + Timer encoder index configuration
  16:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ******************************************************************************
  17:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ==============================================================================
  18:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                       ##### TIMER Extended features #####
  19:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ==============================================================================
  20:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   [..]
  21:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     The Timer Extended features include:
  22:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) Complementary outputs with programmable dead-time for :
  23:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         (++) Output Compare
  24:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         (++) PWM generation (Edge and Center-aligned Mode)
  25:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         (++) One-pulse mode output
  26:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) Synchronization circuit to control the timer with external signals and to
  27:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         interconnect several timers together.
  28:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) Break input to put the timer output signals in reset state or in a known state.
  29:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) Supports incremental (quadrature) encoder and hall-sensor circuitry for
  30:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         positioning purposes
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccTUEeQa.s 			page 2


  31:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) In case of Pulse on compare, configure pulse length and delay
  32:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (#) Encoder index configuration
  33:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  34:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****             ##### How to use this driver #####
  35:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ==============================================================================
  36:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     [..]
  37:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) Initialize the TIM low level resources by implementing the following functions
  38:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****          depending on the selected feature:
  39:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) Hall Sensor output : HAL_TIMEx_HallSensor_MspInit()
  40:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  41:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) Initialize the TIM low level resources :
  42:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         (##) Enable the TIM interface clock using __HAL_RCC_TIMx_CLK_ENABLE();
  43:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****         (##) TIM pins configuration
  44:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****             (+++) Enable the clock for the TIM GPIOs using the following function:
  45:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****               __HAL_RCC_GPIOx_CLK_ENABLE();
  46:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****             (+++) Configure these TIM pins in Alternate function mode using HAL_GPIO_Init();
  47:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  48:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) The external Clock can be configured, if needed (the default clock is the
  49:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****          internal clock from the APBx), using the following function:
  50:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****          HAL_TIM_ConfigClockSource, the clock configuration should be done before
  51:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****          any start function.
  52:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  53:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) Configure the TIM in the desired functioning mode using one of the
  54:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****          initialization function of this driver:
  55:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****           (++) HAL_TIMEx_HallSensor_Init() and HAL_TIMEx_ConfigCommutEvent(): to use the
  56:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                Timer Hall Sensor Interface and the commutation event with the corresponding
  57:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                Interrupt and DMA request if needed (Note that One Timer is used to interface
  58:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                with the Hall sensor Interface and another Timer should be used to use
  59:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                the commutation event).
  60:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) In case of Pulse On Compare:
  61:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) HAL_TIMEx_OC_ConfigPulseOnCompare(): to configure pulse width and prescaler
  62:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  63:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  64:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****      (#) Activate the TIM peripheral using one of the start functions:
  65:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) Complementary Output Compare : HAL_TIMEx_OCN_Start(), HAL_TIMEx_OCN_Start_DMA(),
  66:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                 HAL_TIMEx_OCN_Start_IT()
  67:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) Complementary PWM generation : HAL_TIMEx_PWMN_Start(), HAL_TIMEx_PWMN_Start_DMA(),
  68:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                 HAL_TIMEx_PWMN_Start_IT()
  69:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) Complementary One-pulse mode output : HAL_TIMEx_OnePulseN_Start(), HAL_TIMEx_OnePul
  70:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****            (++) Hall Sensor output : HAL_TIMEx_HallSensor_Start(), HAL_TIMEx_HallSensor_Start_DMA()
  71:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****                 HAL_TIMEx_HallSensor_Start_IT().
  72:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
  73:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   @endverbatim
  74:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   ******************************************************************************
