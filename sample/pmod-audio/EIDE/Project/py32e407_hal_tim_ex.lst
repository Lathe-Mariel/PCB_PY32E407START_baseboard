 145:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****   [..]
 146:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     This section provides functions allowing to:
 147:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Initialize and configure TIM HAL Sensor.
 148:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) De-initialize TIM HAL Sensor.
 149:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface.
 150:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface.
 151:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface and enable interrupts.
 152:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface and disable interrupts.
 153:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface and enable DMA transfers.
 154:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface and disable DMA transfers.
 155:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** 
 156:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim_ex.c **** @endverbatim
