5743:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpcr2 = htim->Instance->CR2;
5744:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
5745:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Reset the TI1 selection */
