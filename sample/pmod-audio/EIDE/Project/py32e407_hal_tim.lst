3124:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Select the Capture Compare 1 and the Capture Compare 2 as input */
3125:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 &= ~(TIM_CCMR1_CC1S | TIM_CCMR1_CC2S);
3126:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 |= (sConfig->IC1Selection | (sConfig->IC2Selection << 8U));
