 264:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   *
 265:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** @verbatim
 266:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   ==============================================================================
 267:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****               ##### Time Base functions #####
 268:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   ==============================================================================
 269:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   [..]
 270:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     This section provides functions allowing to:
 271:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Initialize and configure the TIM base.
 272:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) De-initialize the TIM base.
 273:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Start the Time Base.
 274:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Stop the Time Base.
 275:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Start the Time Base and enable interrupt.
 276:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Stop the Time Base and disable interrupt.
 277:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Start the Time Base and enable DMA transfer.
 278:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     (+) Stop the Time Base and disable DMA transfer.
 279:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 280:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** @endverbatim
 281:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @{
 282:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   */
 283:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** /**
 284:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @brief  Initializes the TIM Time base Unit according to the specified
 285:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   *         parameters in the TIM_HandleTypeDef and initialize the associated handle.
 286:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @note   Switching from Center Aligned counter mode to Edge counter mode (or reverse)
 287:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   *         requires a timer reset to avoid unexpected direction
 288:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   *         due to DIR bit readonly in center aligned mode.
 289:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   *         Ex: call @ref HAL_TIM_Base_DeInit() before HAL_TIM_Base_Init()
 290:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @param  htim TIM Base handle
 291:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @retval HAL status
 292:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   */
 293:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** HAL_StatusTypeDef HAL_TIM_Base_Init(TIM_HandleTypeDef *htim)
 294:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** {
 295:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Check the TIM handle allocation */
 296:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   if (htim == NULL)
 297:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   {
 298:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     return HAL_ERROR;
 299:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   }
 300:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 301:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Check the parameters */
 302:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   assert_param(IS_TIM_INSTANCE(htim->Instance));
 303:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   assert_param(IS_TIM_COUNTER_MODE(htim->Init.CounterMode));
 304:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   assert_param(IS_TIM_CLOCKDIVISION_DIV(htim->Init.ClockDivision));
 305:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   assert_param(IS_TIM_PERIOD(htim, htim->Init.Period));
 306:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   assert_param(IS_TIM_AUTORELOAD_PRELOAD(htim->Init.AutoReloadPreload));
 307:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 308:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   if (htim->State == HAL_TIM_STATE_RESET)
 309:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   {
 310:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     /* Allocate lock resource and initialize it */
 311:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     htim->Lock = HAL_UNLOCKED;
 312:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 313:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** #if (USE_HAL_TIM_REGISTER_CALLBACKS == 1)
 314:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     /* Reset interrupt callbacks to legacy weak callbacks */
 315:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     TIM_ResetCallback(htim);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccFW3Mbe.s 			page 7


 316:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 317:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     if (htim->Base_MspInitCallback == NULL)
 318:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     {
 319:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****       htim->Base_MspInitCallback = HAL_TIM_Base_MspInit;
 320:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     }
 321:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     /* Init the low level hardware : GPIO, CLOCK, NVIC */
 322:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     htim->Base_MspInitCallback(htim);
 323:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** #else
 324:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     /* Init the low level hardware : GPIO, CLOCK, NVIC */
 325:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****     HAL_TIM_Base_MspInit(htim);
 326:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** #endif /* USE_HAL_TIM_REGISTER_CALLBACKS */
 327:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   }
 328:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 329:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Set the TIM state */
 330:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   htim->State = HAL_TIM_STATE_BUSY;
 331:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 332:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Set the Time Base configuration */
 333:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   TIM_Base_SetConfig(htim->Instance, &htim->Init);
 334:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 335:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Initialize the DMA burst operation state */
 336:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   htim->DMABurstState = HAL_DMA_BURST_STATE_READY;
 337:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 338:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Initialize the TIM channels state */
 339:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   TIM_CHANNEL_STATE_SET_ALL(htim, HAL_TIM_CHANNEL_STATE_READY);
 340:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   TIM_CHANNEL_N_STATE_SET_ALL(htim, HAL_TIM_CHANNEL_STATE_READY);
 341:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 342:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Initialize the TIM state*/
 343:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   htim->State = HAL_TIM_STATE_READY;
 344:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 345:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   return HAL_OK;
 346:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** }
 347:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
 348:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** /**
 349:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @brief  DeInitializes the TIM Base peripheral
 350:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @param  htim TIM Base handle
 351:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   * @retval HAL status
 352:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   */
 353:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** HAL_StatusTypeDef HAL_TIM_Base_DeInit(TIM_HandleTypeDef *htim)
