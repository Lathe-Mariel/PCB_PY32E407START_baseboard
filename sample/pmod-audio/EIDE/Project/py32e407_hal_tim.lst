5747:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
5748:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Set the TI1 selection */
