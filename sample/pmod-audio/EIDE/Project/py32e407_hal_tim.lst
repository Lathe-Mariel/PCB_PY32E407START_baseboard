7754:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 &= ~TIM_CCMR1_IC1F;
7755:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 |= ((TIM_ICFilter << 4U) & TIM_CCMR1_IC1F);
