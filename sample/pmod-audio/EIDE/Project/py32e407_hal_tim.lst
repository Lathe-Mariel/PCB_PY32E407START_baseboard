5733:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   */
5734:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** HAL_StatusTypeDef HAL_TIM_ConfigTI1Input(TIM_HandleTypeDef *htim, uint32_t TI1_Selection)
5735:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** {
5736:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   uint32_t tmpcr2;
5737:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
