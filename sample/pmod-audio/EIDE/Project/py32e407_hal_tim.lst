3128:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Set the Capture Compare 1 and the Capture Compare 2 prescalers and filters */
3129:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 &= ~(TIM_CCMR1_IC1PSC | TIM_CCMR1_IC2PSC);
3130:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 &= ~(TIM_CCMR1_IC1F | TIM_CCMR1_IC2F);
3131:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 |= sConfig->IC1Prescaler | (sConfig->IC2Prescaler << 8U);
3132:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccmr1 |= (sConfig->IC1Filter << 4U) | (sConfig->IC2Filter << 12U);
3133:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c **** 
3134:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   /* Set the TI1 and the TI2 Polarities */
3135:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccer &= ~(TIM_CCER_CC1P | TIM_CCER_CC2P);
3136:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccer &= ~(TIM_CCER_CC1NP | TIM_CCER_CC2NP);
3137:../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_tim.c ****   tmpccer |= sConfig->IC1Polarity | (sConfig->IC2Polarity << 4U);
