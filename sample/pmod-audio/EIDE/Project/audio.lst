  19:../Src/audio.c **** /**
  20:../Src/audio.c ****   * @brief  Peripheral used to generate the audio output.
  21:../Src/audio.c ****   *
  22:../Src/audio.c ****   *         PA1 is wired to AF1 on the PY32E407 and AF1 selects TIM2_CH2
  23:../Src/audio.c ****   *         (PY32E407 datasheet, Table 3-3 "Port A alternate functions
  24:../Src/audio.c ****   *         mapping"). The pin only needs a series resistor into a small
  25:../Src/audio.c ****   *         speaker, plus a simple RC low pass filter for sample playback.
  26:../Src/audio.c ****   *
  27:../Src/audio.c ****   *         Sample playback follows the PCM sample with the PWM duty cycle.
  28:../Src/audio.c ****   *
  29:../Src/audio.c ****   *         IMPORTANT - the pin CANNOT be chosen freely: PD8 in particular has no
  30:../Src/audio.c ****   *         timer output at all on the PY32E407 (PY32E407 datasheet, Table 3-6:
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccLXk4Nw.s 			page 2


  31:../Src/audio.c ****   *         AF7 = USART3_TX, AF12 = LCDC_D13, AF13 = ETH_RMII_CRS_DV, AF15 =
  32:../Src/audio.c ****   *         EVENTOUT only), so it cannot generate timer PWM. Use one of the
  33:../Src/audio.c ****   *         timer-capable pins below instead:
  34:../Src/audio.c ****   *
  35:../Src/audio.c ****   *           pin  timer channel   board connection
  36:../Src/audio.c ****   *           PA1  TIM2_CH2 (AF1)  base board: ETH_RMII_REF_CLK, not used here
  37:../Src/audio.c ****   *           PD4  TIM2_CH2 (AF2)  base board: Pmod3 pin 6
  38:../Src/audio.c ****   *           PD6  TIM2_CH4 (AF2)  base board: Pmod3 pin 8
  39:../Src/audio.c ****   *           PD7  TIM2_CH3 (AF2)  base board: Pmod3 pin 1
  40:../Src/audio.c ****   *           PE9  TIM1_CH1 (AF2)  base board: Pmod4 pin 4
  41:../Src/audio.c ****   *           PE11 TIM1_CH2 (AF2)  base board: Pmod4 pin 6
  42:../Src/audio.c ****   *
  43:../Src/audio.c ****   *         Uncomment exactly one AUDIO_PWM_PIN_* selection below.
  44:../Src/audio.c ****   */
  45:../Src/audio.c **** /* #define AUDIO_PWM_PIN_PD4 */
  46:../Src/audio.c **** /* #define AUDIO_PWM_PIN_PD6 */
  47:../Src/audio.c **** #define AUDIO_PWM_PIN_PD7
  48:../Src/audio.c **** /* #define AUDIO_PWM_PIN_PE9 */
  49:../Src/audio.c **** /* #define AUDIO_PWM_PIN_PE11 */
  50:../Src/audio.c **** 
  51:../Src/audio.c **** #if   defined(AUDIO_PWM_PIN_PD4)
  52:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM2
  53:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_2
  54:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM2_CLK_ENABLE()
  55:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOD
  56:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_4
  57:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF2_TIM2
  58:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOD_CLK_ENABLE()
  59:../Src/audio.c **** #elif defined(AUDIO_PWM_PIN_PD6)
  60:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM2
  61:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_4
  62:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM2_CLK_ENABLE()
  63:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOD
  64:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_6
  65:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF2_TIM2
  66:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOD_CLK_ENABLE()
  67:../Src/audio.c **** #elif defined(AUDIO_PWM_PIN_PD7)
  68:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM2
  69:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_3
  70:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM2_CLK_ENABLE()
  71:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOD
  72:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_7
  73:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF2_TIM2
  74:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOD_CLK_ENABLE()
  75:../Src/audio.c **** #elif defined(AUDIO_PWM_PIN_PE9)
  76:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM1
  77:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_1
  78:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM1_CLK_ENABLE()
  79:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOE
  80:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_9
  81:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF2_TIM1
  82:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOE_CLK_ENABLE()
  83:../Src/audio.c **** #elif defined(AUDIO_PWM_PIN_PE11)
  84:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM1
  85:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_2
  86:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM1_CLK_ENABLE()
  87:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOE
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccLXk4Nw.s 			page 3


  88:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_11
  89:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF2_TIM1
  90:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOE_CLK_ENABLE()
  91:../Src/audio.c **** #else
  92:../Src/audio.c ****   /* PA1 = TIM2_CH2 (AF1). */
  93:../Src/audio.c ****   #define AUDIO_PWM_TIM                TIM2
  94:../Src/audio.c ****   #define AUDIO_PWM_CHANNEL            TIM_CHANNEL_2
  95:../Src/audio.c ****   #define AUDIO_PWM_TIM_CLK_ENABLE()   __HAL_RCC_TIM2_CLK_ENABLE()
  96:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PORT          GPIOA
  97:../Src/audio.c ****   #define AUDIO_PWM_GPIO_PIN           GPIO_PIN_1
  98:../Src/audio.c ****   #define AUDIO_PWM_GPIO_AF            GPIO_AF1_TIM2
  99:../Src/audio.c ****   #define AUDIO_PWM_GPIO_CLK_ENABLE()  __HAL_RCC_GPIOA_CLK_ENABLE()
 100:../Src/audio.c **** #endif
 101:../Src/audio.c **** 
 102:../Src/audio.c **** /**
 103:../Src/audio.c ****   * @brief  PWM carrier used for sample playback, in Hz.
 104:../Src/audio.c ****   *
 105:../Src/audio.c ****   *         Sample mode runs the counter straight from the timer clock, so the
 106:../Src/audio.c ****   *         period is large and the duty cycle gets many steps: 256 counts (8
 107:../Src/audio.c ****   *         bits, one step per sample value) at a 16 MHz timer clock. 62.5 kHz
 108:../Src/audio.c ****   *         is far above the audio band, so the carrier itself is inaudible.
 109:../Src/audio.c ****   */
 110:../Src/audio.c **** #define AUDIO_SAMPLE_CARRIER_HZ     62500U
 111:../Src/audio.c **** 
 112:../Src/audio.c **** /**
 113:../Src/audio.c ****   * @brief  Lowest carrier accepted for sample playback, in Hz.
 114:../Src/audio.c ****   *
 115:../Src/audio.c ****   *         Guards against a very slow timer clock ending up with an audible
 116:../Src/audio.c ****   *         carrier.
 117:../Src/audio.c ****   */
 118:../Src/audio.c **** #define AUDIO_SAMPLE_MIN_CARRIER_HZ 40000U
 119:../Src/audio.c **** 
 120:../Src/audio.c **** /**
 121:../Src/audio.c ****   * @brief  Duty span used for the sample playback, in percent of full scale.
 122:../Src/audio.c ****   *
 123:../Src/audio.c ****   *         The audio information of a PWM signal is carried in its duty cycle, so
 124:../Src/audio.c ****   *         the span directly sets both the loudness and the resolution: the duty
 125:../Src/audio.c ****   *         travels over span% of the timer period, i.e. over span% of the 256
 126:../Src/audio.c ****   *         timer counts, which is also the number of quantisation steps that are
 127:../Src/audio.c ****   *         available. A small span therefore means a quiet AND noisy output.
 128:../Src/audio.c ****   *
 129:../Src/audio.c ****   *         This is why the span is 100 % by default. The Pmod-AUDIO V1.2 (and the
 130:../Src/audio.c ****   *         reference designs for it) drive the module from a plain 3V3 logic
 131:../Src/audio.c ****   *         square wave: the PAM8403 acts as a buffer for the PWM and the speaker
 132:../Src/audio.c ****   *         plus its output network recover the audio, so the carrier does not have
 133:../Src/audio.c ****   *         to be attenuated and the full duty range can be used. That gives the
 134:../Src/audio.c ****   *         full 8 bit resolution of the 256 count period.
 135:../Src/audio.c ****   *
 136:../Src/audio.c ****   *         Lower it only to reduce the volume (and accept the extra quantisation
 137:../Src/audio.c ****   *         noise that comes with it), or when the output is fed to a linear
 138:../Src/audio.c ****   *         amplifier that needs a smaller signal.
 139:../Src/audio.c ****   */
 140:../Src/audio.c **** #define AUDIO_SAMPLE_SPAN_PCT       100U
 141:../Src/audio.c **** 
 142:../Src/audio.c **** /**
 143:../Src/audio.c ****   * @brief  Drive of the soft limiter applied to the samples, in percent.
 144:../Src/audio.c ****   *
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccLXk4Nw.s 			page 4


 145:../Src/audio.c ****   *         The soft limiter lifts quiet passages more than the peaks, which makes
 146:../Src/audio.c ****   *         the playback louder at the same peak level:
 147:../Src/audio.c ****   *
 148:../Src/audio.c ****   *             f(s) = s * (1 + k) / (1 + k * |s|)      (s in -1..1, k >= 0)
 149:../Src/audio.c ****   *
 150:../Src/audio.c ****   *         with f(0) = 0, f(1) = 1 and f'(0) = 1 + k. It is disabled by default,
 151:../Src/audio.c ****   *         because with the span at 100 % the playback is already at full scale
 152:../Src/audio.c ****   *         and any compression only costs resolution (the curve squeezes the duty
 153:../Src/audio.c ****   *         values together, so fewer of the 256 steps are used, which raises the
 154:../Src/audio.c ****   *         noise floor). Enable it (100..400) if the material is quiet and extra
 155:../Src/audio.c ****   *         loudness matters more than the last few dB of noise.
 156:../Src/audio.c ****   */
 157:../Src/audio.c **** #define AUDIO_SAMPLE_COMPRESS_PCT   0U
 158:../Src/audio.c **** 
 159:../Src/audio.c **** /**
 160:../Src/audio.c ****   * @brief  Peripheral used to pace the PCM samples.
 161:../Src/audio.c ****   *
 162:../Src/audio.c ****   *         TIM3 only runs internally and drives no pin; its update rate is the
 163:../Src/audio.c ****   *         PCM sample rate.
 164:../Src/audio.c ****   */
 165:../Src/audio.c **** #define AUDIO_SAMPLE_TIM             TIM3
 166:../Src/audio.c **** #define AUDIO_SAMPLE_IRQn            TIM3_IRQn
 167:../Src/audio.c **** #define AUDIO_SAMPLE_TIM_CLK_ENABLE()  __HAL_RCC_TIM3_CLK_ENABLE()
 168:../Src/audio.c **** 
 169:../Src/audio.c **** /** Sample rate limits. */
 170:../Src/audio.c **** #define AUDIO_SAMPLE_MIN_RATE_HZ    8000U
 171:../Src/audio.c **** #define AUDIO_SAMPLE_MAX_RATE_HZ    48000U
 172:../Src/audio.c **** 
 173:../Src/audio.c **** /* Private variables ---------------------------------------------------------*/
 174:../Src/audio.c **** static TIM_HandleTypeDef s_pwm;
 175:../Src/audio.c **** static TIM_HandleTypeDef s_sample;
 176:../Src/audio.c **** 
 177:../Src/audio.c **** static uint32_t s_timer_clk_hz;                /* raw timer clock, for the pacing timer */
 178:../Src/audio.c **** 
 179:../Src/audio.c **** /* Sample (PCM) playback state. */
 180:../Src/audio.c **** static const uint8_t *s_pcm;                   /* sample buffer being played     */
 181:../Src/audio.c **** static uint32_t s_pcm_length;                  /* number of samples              */
 182:../Src/audio.c **** static uint32_t s_pcm_index;                   /* next sample to output          */
 183:../Src/audio.c **** static uint8_t  s_sample_playing;
 184:../Src/audio.c **** 
 185:../Src/audio.c **** /**
 186:../Src/audio.c ****   * @brief  Compare register values for the 256 possible sample bytes.
 187:../Src/audio.c ****   *
 188:../Src/audio.c ****   *         The mapping from a sample to a duty count is a division, which is too
 189:../Src/audio.c ****   *         slow to run in a 16 kHz interrupt at a 16 MHz core clock, so it is
 190:../Src/audio.c ****   *         precomputed once per mode change. 512 bytes of RAM buy a very short
 191:../Src/audio.c ****   *         interrupt handler.
 192:../Src/audio.c ****   */
 193:../Src/audio.c **** static uint16_t s_duty_lut[256];
 194:../Src/audio.c **** 
 195:../Src/audio.c **** /* Private function prototypes -----------------------------------------------*/
 196:../Src/audio.c **** static uint32_t AUDIO_GetTimerClock(uint32_t pclk);
 197:../Src/audio.c **** static void AUDIO_PwmGpioConfig(void);
 198:../Src/audio.c **** static void AUDIO_PwmSampleInit(void);
 199:../Src/audio.c **** static void AUDIO_ProgramPaceTimer(uint32_t rate_hz);
 200:../Src/audio.c **** static void AUDIO_SetSample(uint8_t value);
 201:../Src/audio.c **** static void AUDIO_Mute(void);
ARM GAS  C:\Users\n11ak\AppData\Local\Temp\ccLXk4Nw.s 			page 5


