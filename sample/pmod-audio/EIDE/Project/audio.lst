 269:../Src/audio.c **** /* Sample (PCM) playback -----------------------------------------------------*/
 270:../Src/audio.c **** 
 271:../Src/audio.c **** /**
 272:../Src/audio.c ****   * @brief  Start (or restart) the playback of a PCM sample buffer.
 273:../Src/audio.c ****   *
 274:../Src/audio.c ****   *         The buffer holds unsigned 8 bit samples where 128 is silence. The
 275:../Src/audio.c ****   *         duty cycle of the PWM follows the sample value, so an RC low pass
 276:../Src/audio.c ****   *         filter turns the output back into the original signal.
 277:../Src/audio.c ****   * @param  samples pointer to the unsigned 8 bit samples.
 278:../Src/audio.c ****   * @param  length  number of samples to play.
 279:../Src/audio.c ****   * @param  rate_hz playback rate in Hz (8 kHz to 48 kHz).
 280:../Src/audio.c ****   * @retval None
 281:../Src/audio.c ****   */
 282:../Src/audio.c **** void AUDIO_PlaySample(const uint8_t *samples, uint32_t length, uint32_t rate_hz)
 283:../Src/audio.c **** {
 284:../Src/audio.c ****   if ((samples == NULL) || (length == 0U))
 285:../Src/audio.c ****   {
 286:../Src/audio.c ****     AUDIO_StopSample();
 287:../Src/audio.c ****     return;
 288:../Src/audio.c ****   }
 289:../Src/audio.c **** 
 290:../Src/audio.c ****   if (rate_hz < AUDIO_SAMPLE_MIN_RATE_HZ)
 291:../Src/audio.c ****   {
 292:../Src/audio.c ****     rate_hz = AUDIO_SAMPLE_MIN_RATE_HZ;
 293:../Src/audio.c ****   }
 294:../Src/audio.c ****   if (rate_hz > AUDIO_SAMPLE_MAX_RATE_HZ)
 295:../Src/audio.c ****   {
 296:../Src/audio.c ****     rate_hz = AUDIO_SAMPLE_MAX_RATE_HZ;
 297:../Src/audio.c ****   }
 298:../Src/audio.c **** 
 299:../Src/audio.c ****   __HAL_TIM_DISABLE_IT(&s_sample, TIM_IT_UPDATE);
 300:../Src/audio.c ****   AUDIO_SampleTimerStop();
 301:../Src/audio.c **** 
 302:../Src/audio.c ****   s_pcm            = samples;
 303:../Src/audio.c ****   s_pcm_length     = length;
 304:../Src/audio.c ****   s_pcm_index      = 0U;
 305:../Src/audio.c ****   s_sample_playing = 1U;
 306:../Src/audio.c **** 
 307:../Src/audio.c ****   /* Sample mode: fast carrier, duty from the sample value. */
 308:../Src/audio.c ****   AUDIO_ResetPwm();
 309:../Src/audio.c ****   AUDIO_PwmSampleInit();
 310:../Src/audio.c **** 
 311:../Src/audio.c ****   /* One interrupt per sample, with the period chosen as close to the exact
 312:../Src/audio.c ****      sample interval as the timer clock allows. */
 313:../Src/audio.c ****   AUDIO_ProgramPaceTimer(rate_hz);
 314:../Src/audio.c **** 
