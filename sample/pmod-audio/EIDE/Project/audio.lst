 232:../Src/audio.c **** 
 233:../Src/audio.c ****   oc.OCMode       = TIM_OCMODE_PWM1;
 234:../Src/audio.c ****   oc.Pulse        = 0U;                      /* 0 % duty, i.e. silence */
 235:../Src/audio.c ****   oc.OCPolarity   = TIM_OCPOLARITY_HIGH;
