 207:../Src/audio.c **** /**
 208:../Src/audio.c ****   * @brief  Initialise the PWM output on PA1 and the audio timers.
 209:../Src/audio.c ****   * @param  None
 210:../Src/audio.c ****   * @retval None
 211:../Src/audio.c ****   */
 212:../Src/audio.c **** void AUDIO_Init(void)
 213:../Src/audio.c **** {
 214:../Src/audio.c ****   TIM_OC_InitTypeDef oc = {0};
