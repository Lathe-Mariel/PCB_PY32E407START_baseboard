 522:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** /**
 523:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @brief Enter Standby mode.
 524:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  In Standby mode, the PLL, the HSI and the HSE oscillators are switched
 525:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        off. The voltage regulator is disabled, except when SRAM2 content is preserved
 526:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        in which case the regulator is in low-power mode.
 527:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        SRAM1 and register contents are lost except for registers in the Backup domain and
 528:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        Standby circuitry. SRAM2 content can be preserved if the bit RRS is set in PWR_CR3 regis
 529:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        To enable this feature, the user can resort to HAL_PWREx_EnableSRAM2ContentRetention() A
 530:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        to set RRS bit.
 531:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        The BOR is available.
 532:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @retval None
 533:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   */
