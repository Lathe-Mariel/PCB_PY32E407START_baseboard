 412:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** /**
 413:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @brief Enter Sleep or Low-power Sleep mode.
 414:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  In Sleep/Low-power Sleep mode, all I/O pins keep the same state as in Run mode.
 415:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @param Regulator: Specifies the regulator state in Sleep/Low-power Sleep mode.
 416:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *          This parameter can be one of the following values:
 417:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_MAINREGULATOR_ON Sleep mode (regulator in main mode)
 418:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_LOWPOWERREGULATOR_ON Low-power Sleep mode (regulator in low-power mode
 419:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  Low-power Sleep mode is entered from Low-power Run mode. Therefore, if not yet
 420:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        in Low-power Run mode before calling HAL_PWR_EnterSLEEPMode() with Regulator set
 421:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        to PWR_LOWPOWERREGULATOR_ON.
 422:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        Additionally, the clock frequency must be reduced below 2 MHz.
 423:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  When exiting Low-power Sleep mode, the MCU is in Low-power Run mode. To move in
 424:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        Run mode, the user must resort to HAL_PWREx_DisableLowPowerRunMode() API.
 425:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @param SLEEPEntry: Specifies if Sleep mode is entered with WFI or WFE instruction.
 426:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *           This parameter can be one of the following values:
 427:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_SLEEPENTRY_WFI enter Sleep or Low-power Sleep mode with WFI instructio
 428:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_SLEEPENTRY_WFE enter Sleep or Low-power Sleep mode with WFE instructio
 429:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  When WFI entry is used, tick interrupt have to be disabled if not desired as
 430:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        the interrupt wake up source.
 431:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @retval None
 432:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   */
