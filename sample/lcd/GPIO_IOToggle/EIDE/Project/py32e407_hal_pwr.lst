 477:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** 
 478:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** /**
 479:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @brief Enter Stop mode
 480:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  This API is named HAL_PWR_EnterSTOPMode to ensure compatibility with legacy code running
 481:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        on devices where only "Stop mode" is mentioned with main or low power regulator ON.
 482:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  In Stop mode, all I/O pins keep the same state as in Run mode.
 483:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  All clocks in the VCORE domain are stopped; the PLL,
 484:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        the HSI and the HSE oscillators are disabled. Some peripherals with the wakeup capabilit
 485:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        (I2Cx, LPUART) can switch on the HSI to receive a frame, and switch off the HSI
 486:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        after receiving the frame if it is not a wakeup frame. In this case, the HSI clock is pr
 487:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        only to the peripheral requesting it.
 488:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        SRAM1, SRAM2 and register contents are preserved.
 489:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        The BOR is available.
 490:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *        The voltage regulator can be configured either in normal (Stop 0) or low-power mode (Sto
 491:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  When exiting Stop 0 or Stop 1 mode by issuing an interrupt or a wakeup event,
 492:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *         the HSI RC oscillator is selected as system clock.
 493:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @note  When the voltage regulator operates in low power mode (Stop 1), an additional
 494:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *         startup delay is incurred when waking up.
 495:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *         By keeping the internal regulator ON during Stop mode (Stop 0), the consumption
 496:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *         is higher although the startup time is reduced.
 497:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @param Regulator: Specifies the regulator state in Stop mode.
 498:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *          This parameter can be one of the following values:
 499:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_MAINREGULATOR_ON  Stop 0 mode (main regulator ON)
 500:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_LOWPOWERREGULATOR_ON  Stop 1 mode (low power regulator ON)
 501:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @param STOPEntry: Specifies Stop 0 or Stop 1 mode is entered with WFI or WFE instruction.
 502:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *          This parameter can be one of the following values:
 503:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_STOPENTRY_WFI  Enter Stop 0 or Stop 1 mode with WFI instruction.
 504:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   *            @arg @ref PWR_STOPENTRY_WFE  Enter Stop 0 or Stop 1 mode with WFE instruction.
 505:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   * @retval None
 506:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c ****   */
 507:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** void HAL_PWR_EnterSTOPMode(uint32_t Regulator, uint8_t STOPEntry)
 508:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_pwr.c **** {
