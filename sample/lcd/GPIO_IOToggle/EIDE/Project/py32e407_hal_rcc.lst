   1:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** /**
   2:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   ******************************************************************************
   3:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @file    py32e407_hal_rcc.c
   4:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @author  MCU Application Team
   5:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @brief   RCC HAL module driver.
   6:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *          This file provides firmware functions to manage the following
   7:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *          functionalities of the Reset and Clock Control (RCC) peripheral:
   8:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *           + Initialization and de-initialization functions
   9:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *           + Peripheral Control functions
  10:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *
  11:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   @verbatim
  12:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   ==============================================================================
  13:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****                       ##### RCC specific features #####
  14:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   ==============================================================================
  15:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     [..]
  16:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       After reset the device is running from Internal High Speed oscillator
  17:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (HSI 16MHz) with Flash 0 wait state, Flash prefetch buffer is enabled,
  18:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       and all peripherals are off except internal SRAM, Flash and JTAG.
  19:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) There is no prescaler on High speed (AHB) and Low speed (APB) buses;
  20:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****           all peripherals mapped on these buses are running at HSI speed.
  21:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) The clock for all peripherals is switched off, except the SRAM and FLASH.
  22:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) All GPIOs are in input floating state, except the JTAG pins which
  23:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****           are assigned to be used for debug purpose.
  24:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     [..] Once the device started from reset, the user application has to:
  25:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) Configure the clock source to be used to drive the System clock
  26:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****           (if the application needs higher frequency/performance)
  27:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) Configure the System clock frequency and Flash settings
  28:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) Configure the AHB and APB buses prescalers
  29:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) Enable the clock for the peripheral(s) to be used
  30:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) Configure the clock source(s) for peripherals whose clocks are not
  31:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****           derived from the System clock ( RTC, ADC, PVD, USB, CAN )
ARM GAS  C:\Users\user\AppData\Local\Temp\ccuc8vss.s 			page 2


  32:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
  33:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****                       ##### RCC Limitations #####
  34:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   ==============================================================================
  35:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     [..]
  36:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       A delay between an RCC peripheral clock enable and the effective peripheral
  37:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       enabling should be taken into account in order to manage the peripheral read/write
  38:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       from/to registers.
  39:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (+) This delay depends on the peripheral mapping.
  40:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****         (++) AHB & APB peripherals, 1 dummy read is necessary
  41:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
  42:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     [..]
  43:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       Workarounds:
  44:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       (#) For AHB & APB peripherals, a dummy read to the peripheral register has been
  45:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****           inserted in each __HAL_RCC_PPP_CLK_ENABLE() macro.
  46:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
  47:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   @endverbatim
  48:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   ******************************************************************************
