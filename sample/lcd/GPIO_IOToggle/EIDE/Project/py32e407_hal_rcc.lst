1020:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** /**
1021:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @brief  Enables the Clock Security System.
1022:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   If a failure is detected on the HSE oscillator clock, this oscillator
1023:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         is automatically disabled and an interrupt is generated to inform the
1024:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         software about the failure (Clock Security System Interrupt, CSSI),
1025:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         allowing the MCU to perform rescue operations. The CSSI is linked to
1026:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         the Cortex-M4 NMI (Non-Maskable Interrupt) exception vector.
1027:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @retval None
1028:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   */
1029:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** void HAL_RCC_EnableCSS(void)
1030:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** {
1031:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   SET_BIT(RCC->CR, RCC_CR_CSSON);
1032:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** }
1033:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
1034:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** /**
1035:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @brief  Returns the SYSCLK frequency
1036:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   The system frequency computed by this function is not the real
1037:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         frequency in the chip. It is calculated based on the predefined
1038:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         constant and the selected clock source:
1039:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note     If SYSCLK source is HSI, function returns values based on HSI_VALUE(*)
1040:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note     If SYSCLK source is HSE, function returns a value based on HSE_VALUE(**)
1041:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note     If SYSCLK source is PLL, function returns values based on HSE_VALUE(**),
1042:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *           HSI_VALUE(*) Value multiplied/divided by the PLL factors.
1043:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note     (*) HSI_VALUE is a constant defined in py32e407_hal_conf.h file,
1044:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *               but the real value may vary depending on the variations
1045:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *               in voltage and temperature.
1046:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note     (**) HSE_VALUE is a constant defined in py32e407_hal_conf.h file,
1047:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *                user has to ensure that HSE_VALUE is same as the real
1048:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *                frequency of the crystal used. Otherwise, this function may
1049:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *                have wrong result.
1050:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *
1051:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   The result of this function could be not correct when using fractional
1052:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         value for HSE crystal.
1053:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *
1054:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   This function can be used by the user application to compute the
1055:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         baud-rate for the communication peripherals or configure other parameters.
1056:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *
1057:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   Each time SYSCLK changes, this function must be called to update the
ARM GAS  C:\Users\user\AppData\Local\Temp\ccuc8vss.s 			page 20


1058:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         right SYSCLK value. Otherwise, any configuration based on this function will be incorre
1059:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *
1060:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @retval SYSCLK frequency
1061:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   */
1062:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** uint32_t HAL_RCC_GetSysClockFreq(void)
1063:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** {
1064:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   const uint8_t aDivFactorTable[4] = {1, 2, 4, 8};
1065:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   const uint8_t aXTPredivFactorTable[2] = {1, 2};
1066:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
1067:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   uint32_t tmpreg = 0U, tmppllreg=0, pllxtprediv = 0U, pllclk = 0U, pllmul = 0U, pllprediv = 0U, pl
1068:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   uint32_t sysclockfreq = 0U;
1069:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
1070:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   tmpreg = RCC->CFGR;
1071:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   
1072:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   tmppllreg = RCC->CFGR3;
1073:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** 
1074:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   /* Get SYSCLK source -------------------------------------------------------*/
1075:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   switch (tmpreg & RCC_CFGR_SWS)
1076:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   {
1077:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     case RCC_SYSCLKSOURCE_STATUS_HSE:  /* HSE used as system clock */
1078:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     {
1079:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       sysclockfreq = HSE_VALUE;
1080:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       break;
1081:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     }
1082:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     case RCC_SYSCLKSOURCE_STATUS_PLLCLK:  /* PLL used as system clock */
1083:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****     {
1084:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****       pllprediv = aDivFactorTable[(uint32_t)(RCC->CFGR3 & RCC_CFGR3_PLLPREDIV) >> RCC_CFGR3_PLLPRED
