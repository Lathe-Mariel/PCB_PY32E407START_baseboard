 949:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c **** /**
 950:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @brief  Select the clock source to output on MCO pin(PA8/PF5).
 951:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   PA8/PF5 should be configured in alternate function mode.
 952:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @note   The default configuration of the GPIOF pin 5 (PF5) is set to reset mode (NRST pin)
 953:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         and user shall set the NRST_MODE Bit in the FLASH OPTR register to be able to use it 
 954:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         as an MCO pin.
 955:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *         The @ref HAL_FLASH_OBProgram() API can be used to configure the NRST_MODE Bit value.
 956:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @param  RCC_MCOx  specifies the output direction for the clock source.
 957:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *          For PY32E407xx family this parameter can have only one value:
 958:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCO1  Clock source to output on MCO1 pin(PA8).
 959:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCO2  Clock source to output on MCO1 pin(PF5).
 960:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @param  RCC_MCOSource  specifies the clock source to output.
 961:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *          This parameter can be one of the following values:
 962:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_NOCLOCK  MCO output disabled, no clock on MCO
 963:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_SYSCLK  system  clock selected as MCO source
 964:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_HSI16M  HSI16M clock selected as MCO source
 965:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_LSI  LSI clock selected as MCO source
 966:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_HSE  HSE clock selected as MCO sourcee
 967:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_LSE  LSE clock selected as MCO source
 968:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_PLLCLK  main PLL clock selected as MCO source
 969:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_HSI48M  HSI48M clock selected as MCO source for devices with
 970:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_HCLK  HCLK clock selected as MCO source
 971:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_PCLK1  APB1 clock selected as MCO sourcee
 972:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_PCLK2  APB2 clock selected as MCO source
 973:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCOSOURCE_HSI10M  HSI10M clock selected as MCO source
 974:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @param  RCC_MCODiv  specifies the MCO prescaler.
 975:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *          This parameter can be one of the following values:
 976:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_1  no division applied to MCO clock
 977:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_2  division by 2 applied to MCO clock
 978:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_4  division by 4 applied to MCO clock
 979:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_8  division by 8 applied to MCO clock
 980:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_16  division by 16 applied to MCO clock
 981:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_32  division by 32 applied to MCO clock
 982:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_64  division by 64 applied to MCO clock
 983:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   *            @arg @ref RCC_MCODIV_128  division by 128 applied to MCO clock
 984:../../../../../../Drivers/PY32E407_HAL_Driver/Src/py32e407_hal_rcc.c ****   * @retval None
