 375:../Src/main.c **** /* Blit an RGB565 image into a (x,y)-(x+w-1,y+h-1) window. CS is asserted once
 376:../Src/main.c ****    for the whole memory-write burst. */
 377:../Src/main.c **** static void LCD_DrawImage(uint16_t x, uint16_t y, uint16_t w, uint16_t h,
 378:../Src/main.c ****                           const uint16_t *pixels)
 379:../Src/main.c **** {
 380:../Src/main.c ****   uint32_t count = (uint32_t)w * (uint32_t)h;
 381:../Src/main.c **** 
 382:../Src/main.c ****   LCD_SetRegion(x, y, (uint16_t)(x + w - 1U), (uint16_t)(y + h - 1U));
 383:../Src/main.c **** 
 384:../Src/main.c ****   LCD_WriteCommand(0x2CU);
 385:../Src/main.c **** 
 386:../Src/main.c ****   HAL_GPIO_WritePin(LCD_RS_PORT, LCD_RS_PIN, GPIO_PIN_SET);
 387:../Src/main.c ****   HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_RESET);
 388:../Src/main.c **** 
 389:../Src/main.c ****   for (uint32_t i = 0U; i < count; ++i)
 390:../Src/main.c ****   {
 391:../Src/main.c ****     LCD_WritePixel(pixels[i]);
 392:../Src/main.c ****   }
