 100:../Src/main.c ****   HAL_Delay(400);
 101:../Src/main.c **** 
 102:../Src/main.c ****   LCD_Init();   /* clears the screen to white */
 103:../Src/main.c **** 
 104:../Src/main.c ****   /* DVD-style bouncing logo over a white background.
 105:../Src/main.c ****      Erase only the strip the logo leaves behind, one rectangle per axis. */
 106:../Src/main.c ****   while (1)
 107:../Src/main.c ****   {
 108:../Src/main.c ****     int16_t old_x = x;
 109:../Src/main.c ****     int16_t old_y = y;
 110:../Src/main.c **** 
 111:../Src/main.c ****     x += dx;
 112:../Src/main.c ****     y += dy;
 113:../Src/main.c **** 
 114:../Src/main.c ****     if (x <= 0)
 115:../Src/main.c ****     {
 116:../Src/main.c ****       x    = 0;
 117:../Src/main.c ****       dx   = (int8_t)(-dx);
 118:../Src/main.c ****     }
 119:../Src/main.c ****     else if (x >= (int16_t)(LCD_WIDTH - PUYA_LOGO_WIDTH))
 120:../Src/main.c ****     {
 121:../Src/main.c ****       x    = (int16_t)(LCD_WIDTH - PUYA_LOGO_WIDTH);
 122:../Src/main.c ****       dx   = (int8_t)(-dx);
 123:../Src/main.c ****     }
 124:../Src/main.c **** 
 125:../Src/main.c ****     if (y <= 0)
 126:../Src/main.c ****     {
 127:../Src/main.c ****       y    = 0;
 128:../Src/main.c ****       dy   = (int8_t)(-dy);
 129:../Src/main.c ****     }
 130:../Src/main.c ****     else if (y >= (int16_t)(LCD_HEIGHT - PUYA_LOGO_HEIGHT))
 131:../Src/main.c ****     {
 132:../Src/main.c ****       y    = (int16_t)(LCD_HEIGHT - PUYA_LOGO_HEIGHT);
 133:../Src/main.c ****       dy   = (int8_t)(-dy);
 134:../Src/main.c ****     }
 135:../Src/main.c **** 
 136:../Src/main.c ****     /* Erase the area the logo previously occupied but does not cover now. */
 137:../Src/main.c ****     if (x > old_x)
 138:../Src/main.c ****     {
 139:../Src/main.c ****       LCD_FillRect((uint16_t)old_x, (uint16_t)old_y, (uint16_t)(x - old_x),
 140:../Src/main.c ****                    PUYA_LOGO_HEIGHT, LCD_WHITE);
 141:../Src/main.c ****     }
 142:../Src/main.c ****     else if (x < old_x)
 143:../Src/main.c ****     {
 144:../Src/main.c ****       LCD_FillRect((uint16_t)(x + PUYA_LOGO_WIDTH), (uint16_t)old_y,
ARM GAS  C:\Users\user\AppData\Local\Temp\ccqcwdMl.s 			page 4


 145:../Src/main.c ****                    (uint16_t)(old_x - x), PUYA_LOGO_HEIGHT, LCD_WHITE);
 146:../Src/main.c ****     }
 147:../Src/main.c **** 
 148:../Src/main.c ****     if (y > old_y)
 149:../Src/main.c ****     {
 150:../Src/main.c ****       LCD_FillRect((uint16_t)old_x, (uint16_t)old_y, PUYA_LOGO_WIDTH,
 151:../Src/main.c ****                    (uint16_t)(y - old_y), LCD_WHITE);
 152:../Src/main.c ****     }
 153:../Src/main.c ****     else if (y < old_y)
 154:../Src/main.c ****     {
 155:../Src/main.c ****       LCD_FillRect((uint16_t)old_x, (uint16_t)(y + PUYA_LOGO_HEIGHT),
 156:../Src/main.c ****                    PUYA_LOGO_WIDTH, (uint16_t)(old_y - y), LCD_WHITE);
 157:../Src/main.c ****     }
 158:../Src/main.c **** 
 159:../Src/main.c ****     /* Erase regions that are outside the old footprint (only reachable when the
 160:../Src/main.c ****        logo was clamped at an edge). Cheap no-ops in the common case. */
 161:../Src/main.c **** 
 162:../Src/main.c ****     LCD_DrawImage((uint16_t)x, (uint16_t)y, PUYA_LOGO_WIDTH, PUYA_LOGO_HEIGHT,
 163:../Src/main.c ****                   puya_logo);
 164:../Src/main.c **** 
 165:../Src/main.c ****     LCD_DebugLedShow(3U);
 166:../Src/main.c ****     HAL_Delay(LOGO_FRAME_DELAY_MS);
 167:../Src/main.c ****   }
