 325:../Src/main.c **** 
 326:../Src/main.c **** /* Toggle each control line slowly and independently so you can verify it on a
 327:../Src/main.c ****    scope / LED / continuity check before trusting the whole protocol. */
 328:../Src/main.c **** static void LCD_WriteCommand(uint8_t cmd)
 329:../Src/main.c **** {
 330:../Src/main.c ****   HAL_GPIO_WritePin(LCD_RS_PORT, LCD_RS_PIN, GPIO_PIN_RESET);
 331:../Src/main.c ****   HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_RESET);
 332:../Src/main.c ****   LCD_WriteByte(cmd);
 333:../Src/main.c ****   HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_SET);
 334:../Src/main.c **** }
 335:../Src/main.c **** 
 336:../Src/main.c **** /* Send a command together with all of its parameters inside ONE CS-low frame.
 337:../Src/main.c ****    The ILI9341 expects CS to stay low from the command byte through the last
 338:../Src/main.c ****    parameter; raising CS in between can terminate the command early and make
 339:../Src/main.c ****    the parameter bytes be ignored. */
 340:../Src/main.c **** static void LCD_WriteCmdData(uint8_t cmd, const uint8_t *data, uint32_t len)
 341:../Src/main.c **** {
 342:../Src/main.c ****   HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_RESET);
 343:../Src/main.c **** 
 344:../Src/main.c ****   HAL_GPIO_WritePin(LCD_RS_PORT, LCD_RS_PIN, GPIO_PIN_RESET);
 345:../Src/main.c ****   LCD_WriteByte(cmd);
 346:../Src/main.c **** 
 347:../Src/main.c ****   HAL_GPIO_WritePin(LCD_RS_PORT, LCD_RS_PIN, GPIO_PIN_SET);
 348:../Src/main.c ****   for (uint32_t i = 0U; i < len; ++i)
 349:../Src/main.c ****   {
 350:../Src/main.c ****     LCD_WriteByte(data[i]);
 351:../Src/main.c ****   }
 352:../Src/main.c **** 
 353:../Src/main.c ****   HAL_GPIO_WritePin(LCD_CS_PORT, LCD_CS_PIN, GPIO_PIN_SET);
 354:../Src/main.c **** }
 355:../Src/main.c **** 
 356:../Src/main.c **** static void LCD_SetRegion(uint16_t x_start, uint16_t y_start, uint16_t x_end, uint16_t y_end)
 357:../Src/main.c **** {
 358:../Src/main.c ****   const uint8_t col[4] = {(uint8_t)(x_start >> 8U), (uint8_t)x_start,
 359:../Src/main.c ****                           (uint8_t)(x_end >> 8U),   (uint8_t)x_end};
 360:../Src/main.c ****   const uint8_t row[4] = {(uint8_t)(y_start >> 8U), (uint8_t)y_start,
ARM GAS  C:\Users\user\AppData\Local\Temp\ccqcwdMl.s 			page 13


 361:../Src/main.c ****                           (uint8_t)(y_end >> 8U),   (uint8_t)y_end};
 362:../Src/main.c **** 
 363:../Src/main.c ****   LCD_WriteCmdData(0x2AU, col, 4U);
 364:../Src/main.c ****   LCD_WriteCmdData(0x2BU, row, 4U);
 365:../Src/main.c **** }
