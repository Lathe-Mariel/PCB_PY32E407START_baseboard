 231:../Src/main.c **** /* Active-Low indicator: lights LED1..LED4 according to the init stage.
 232:../Src/main.c ****    stage 1 = LED1 only, stage 2 = LED1+LED2, stage 3 = all four. */
 233:../Src/main.c **** static void LCD_DebugLedShow(uint8_t stage)
 234:../Src/main.c **** {
 235:../Src/main.c ****   DBG_LED_OFF(DBG_LED1_PIN);
 236:../Src/main.c ****   DBG_LED_OFF(DBG_LED2_PIN);
 237:../Src/main.c ****   DBG_LED_OFF(DBG_LED3_PIN);
 238:../Src/main.c ****   DBG_LED_OFF(DBG_LED4_PIN);
 239:../Src/main.c **** 
 240:../Src/main.c ****   if (stage >= 1U)
 241:../Src/main.c ****   {
 242:../Src/main.c ****     DBG_LED_ON(DBG_LED1_PIN);
 243:../Src/main.c ****   }
 244:../Src/main.c ****   if (stage >= 2U)
 245:../Src/main.c ****   {
 246:../Src/main.c ****     DBG_LED_ON(DBG_LED2_PIN);
 247:../Src/main.c ****   }
 248:../Src/main.c ****   if (stage >= 3U)
 249:../Src/main.c ****   {
 250:../Src/main.c ****     DBG_LED_ON(DBG_LED3_PIN);
 251:../Src/main.c ****   }
 252:../Src/main.c ****   if (stage >= 4U)
 253:../Src/main.c ****   {
 254:../Src/main.c ****     DBG_LED_ON(DBG_LED4_PIN);
 255:../Src/main.c ****   }
 256:../Src/main.c **** }
